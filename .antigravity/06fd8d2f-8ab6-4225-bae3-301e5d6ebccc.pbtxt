    \"content\": {\n          \"type\": \"string\",\n          \"description\": \"Markdown body content of the blog post\"\n        },\n        \"summary\": {\n          \"type\": \"string\",\n          \"description\": \"Brief summary text for cards\"\n        },\n        \"category\": {\n          \"type\": \"string\",\n          \"description\": \"Category/Topic of the post\"\n        },\n        \"readTime\": {\n          \"type\": \"string\",\n          \"description\": \"Estimated reading time (e.g., \'5 min read\')\"\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"When the post was written\"\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"enum\": [\"draft\", \"published\"],\n          \"description\": \"Publish status of the post\"\n        }\n      },\n      \"required\": [\"id\", \"title\", \"content\", \"summary\", \"category\", \"readTime\", \"createdAt\", \"status\"]\n    },\n    \"Message\": {\n      \"title\": \"Message\",\n      \"description\": \"A contact form submission from a visitor\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"description\": \"Unique identifier for the contact query\"\n        },\n        \"name\": {\n          \"type\": \"string\",\n          \"description\": \"Sender name\"\n        },\n        \"email\": {\n          \"type\": \"string\",\n          \"format\": \"email\",\n          \"description\": \"Sender email\"\n        },\n        \"message\": {\n          \"type\": \"string\",\n          \"description\": \"Deep query content\"\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"When the message was sent\"\n        }\n      },\n      \"required\": [\"id\", \"name\", \"email\", \"message\", \"createdAt\"]\n    }\n  },\n  \"firestore\": {\n    \"/projects/{projectId}\": {\n      \"schema\": \"Project\",\n      \"description\": \"Portfolio showcase projects\"\n    },\n    \"/blogs/{blogId}\": {\n      \"schema\": \"Blog\",\n      \"description\": \"Professional reflections & articles\"\n    },\n    \"/messages/{messageId}\": {\n      \"schema\": \"Message\",\n      \"description\": \"Contact form submissions from visitors\"\n    }\n  }\n}"
