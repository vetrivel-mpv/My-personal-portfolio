      replacement_content: "import React, { useState } from \"react\";\nimport { \n  ArrowRight, \n  Terminal, \n  Cloud, \n  Layers, \n  Award, \n  Network, \n  Cpu, \n  CheckCircle, \n  Play, \n  ChevronRight,\n  ShieldCheck,\n  Zap\n} from \"lucide-react\";\n\ninterface HeroProps {\n  onExploreProjects: () => void;\n  onExploreVision: () => void;\n}\n\nexport default function Hero({ onExploreProjects, onExploreVision }: HeroProps) {\n  // Console simulator state\n  const [activeTelemetryTab, setActiveTelemetryTab] = useState<\"topology\" | \"billing\" | \"sla\">(\"topology\");\n  const [consoleLogs, setConsoleLogs] = useState<string[]>([\n    \"INITIALIZING SYSTEM TELEMETRY...\",\n    \"ESTABLISHED SOUTHBOUND ADAPTOR: CONNECTED\",\n    \"LISTENING FOR SNMP TRAPS ON PORT 162...\"\n  ]);\n  const [isSimulating, setIsSimulating] = useState(false);\n\n  const triggerSimulation = () => {\n    if (isSimulating) return;\n    setIsSimulating(true);\n    setConsoleLogs(prev => [...prev, `\342\235\257 INITIATING FORCED NETWORK DIAGNOSTICS...`]);\n\n    setTimeout(() => {\n      setConsoleLogs(prev => [\n        ...prev,\n        `\342\234\246 POLLING 14 CRITICAL EMS/NMS TOPOLOGY NODES...`,\n        `\342\234\223 ALL TELECOM SOUTHBOUND RECEPTORS RESPONDED IN 14ms`\n      ]);\n    }, 600);\n\n    setTimeout(() => {\n      setConsoleLogs(prev => [\n        ...prev,\n        `\342\234\246 VERIFYING TM-FORUM DATA CONTRACT INTEGRITY...`,\n        `\342\234\246 BILLING DB LAG: 0.1ms (OPTIMIZED)`\n      ]);\n    }, 1200);\n\n    setTimeout(() => {\n      setConsoleLogs(prev => [\n        ...prev,\n        `\342\234\246 SUCCESS: FAULT-TOLERANT ARCHITECTURE STANDARDS APPLIED.`\n      ]);\n      setIsSimulating(false);\n    }, 1800);\n  };\n\n  const handleTelemetrySelect = (tab: \"topology\" | \"billing\" | \"sla\") => {\n    setActiveTelemetryTab(tab);\n    if (tab === \"topology\") {\n      setConsoleLogs([\n        \"SYSTEM OVERVIEW: OSS NETWORK TOPOLOGY\",\n        \"\342\235\257 Validated multiple high-voltage EMS southbound adapters\",\n        \"\342\235\257 Interoperability compliance: 100% green\",\n        \"\342\235\257 Dynamic routing check: ACTIVE\"\n      ]);\n    } else if (tab === \"billing\") {\n      setConsoleLogs([\n        \"SYSTEM OVERVIEW: BSS SUBSCRIBER API\",\n        \"\342\235\257 Checked 4 modernized microservices billing pipelines\",\n        \"\342\235\257 Security token standard: TLS 1.3 / OAuth2\",\n        \"\342\235\257 Double billing trigger: STRICTLY BLOCKED\"\n      ]);\n    } else {\n      setConsoleLogs([\n        \"SYSTEM OVERVIEW: SLA ASSURANCE RULES\",\n        \"\342\235\257 Metric tracer monitoring standard: G-984 GPON\",\n        \"\342\235\257 Latency limit: <10ms peak threshold\",\n        \"\342\235\257 Alarm suppression rule engine: ARRESTED\"\n      ]);\n    }\n  };\n\n  return (\n    <section\n      id=\"home\"\n      className=\"relative min-h-[92vh] flex items-center pt-24 pb-16 px-4 md:px-8 xl:px-12 overflow-hidden bg-slate-900 text-slate-100 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-300\"\n    >\n      {/* Dynamic Background Architectural Grid and Radial Gradient Mesh */}\n      <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:4.5rem_4.5rem] [mask-image:radial-gradient(ellipse_60%_55%_at_50%_10%,#000_80%,transparent_100%)] opacity-30 dark:opacity-25 pointer-events-none\" />\n      <div className=\"absolute top-10 right-[-5%] w-[500px] h-[550px] rounded-full bg-blue-500/10 dark:bg-sky-500/5 blur-[120px] pointer-events-none\" />\n      <div className=\"absolute bottom-[-10%] left-[-5%] w-[450px] h-[450px] rounded-full bg-violet-600/10 dark:bg-indigo-600/5 blur-[100px] pointer-events-none\" />\n\n      {/* Decorative vertical blueprint lines */}\n      <div className=\"absolute left-8 top-0 bottom-0 w-[1px] bg-slate-800/45 hidden xl:block\" />\n      <div className=\"absolute right-8 top-0 bottom-0 w-[1px] bg-slate-800/45 hidden xl:block\" />\n\n      <div className=\"max-w-6xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10\">\n        \n        {/* Left main presentation panel */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          <div className=\"inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-blue-500/10 dark:bg-sky-500/10 border border-blue-500/20 text-blue-400 dark:text-sky-450 text-xs font-mono font-medium tracking-wide\">\n            <span className=\"flex h-2 w-2 relative\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-blue-500\"></span>\n            </span>\n            SYSTEM ARCHITECT BLUEPRINT\n          </div>\n\n          <div className=\"space-y-3\">\n            <h1 className=\"text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight\">\n              Vetrivel <span className=\"bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-400 bg-clip-text text-transparent\">Muthusamy</span>\n            </h1>\n            <p className=\"text-lg md:text-xl font-mono text-slate-350 dark:text-sky-300/90 flex items-center gap-1.5 flex-wrap\">\n              <span>Test Architect & Lead</span> \n              <span className=\"text-blue-500 font-bold\">\342\206\222</span> \n              <span className=\"text-white border-b-2 border-blue-500 pb-0.5\">Solution Architect</span>\n            </p>\n          </div>\n\n          <p className=\"text-sm md:text-base text-slate-300 dark:text-slate-300 font-sans leading-relaxed max-w-xl\">\n            Leveraging **11+ years** of end-to-end domain precision in telecom OSS/BSS platforms. Rooted in systems validation across Europe and the US, reinforced with full-stack development capability (Java/Spring/React) and CSPO certified agile standards. I bridge business blueprints down into pristine, fault-tolerant execution.\n          </p>\n\n          {/* Interactive Career Timeline Loop */}\n          <div className=\"p-4 rounded-xl border border-slate-800 bg-slate-900/50 space-y-3.5\">\n            <span className=\"block text-[10px] font-mono uppercase tracking-wider text-slate-500\">CAREER PROGRESSION CHRONOLOGY:</span>\n            <div className=\"grid grid-cols-4 gap-2 relative\">\n              {/* Arrow connectors */}\n              <div className=\"absolute top-[14px] left-[10%] right-[10%] h-[1px] bg-slate-800 z-0 hidden sm:block\" />\n\n              <div className=\"z-10 text-center sm:text-left\">\n                <div className=\"w-7 h-7 rounded-full bg-slate-800 text-[10px] font-mono text-slate-400 flex items-center justify-center mx-auto sm:mx-0 font-bold border border-slate-705\">01</div>\n                <h4 className=\"text-[10px] font-mono font-bold mt-2 text-slate-400\">QA AUDITOR</h4>\n                <p className=\"text-[9px] text-slate-500 hidden sm:block mt-0.5\">Telecom OSS, Core protocols</p>\n              </div>\n\n              <div className=\"z-10 text-center sm:text-left\">\n                <div className=\"w-7 h-7 rounded-full bg-slate-800 text-[10px] font-mono text-slate-400 flex items-center justify-center mx-auto sm:mx-0 font-bold border border-slate-705\">02</div>\n                <h4 className=\"text-[10px] font-mono font-bold mt-2 text-slate-400 font-bold\">FULL-STACK</h4>\n                <p className=\"text-[9px] text-slate-500 hidden sm:block mt-0.5\">Java, Spring Boot, React</p>\n              </div>\n\n              <div className=\"z-10 text-center sm:text-left\">\n                <div className=\"w-7 h-7 rounded-full bg-slate-800 text-[10px] font-mono text-slate-400 flex items-center justify-center mx-auto sm:mx-0 font-bold border border-slate-705\">03</div>\n                <h4 className=\"text-[10px] font-mono font-bold mt-2 text-slate-400 font-bold\">TEST METHOD</h4>\n                <p className=\"text-[9px] text-slate-500 hidden sm:block mt-0.5\">Lead Architect @ Capgemini</p>\n              </div>\n\n              <div className=\"z-10 text-center sm:text-left\">\n                <div className=\"w-7 h-7 rounded-full bg-blue-600 text-[10px] font-mono text-white flex items-center justify-center mx-auto sm:mx-0 font-bold shadow-md shadow-blue-500/20\">04</div>\n                <h4 className=\"text-[10px] font-mono font-bold mt-2 text-sky-400 font-black\">SOLUTIONS</h4>\n                <p className=\"text-[9px] text-sky-400/70 hidden sm:block mt-0.5\">Fault-tolerant enterprise</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Action triggers */}\n          <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n            <button\n              onClick={onExploreProjects}\n              className=\"px-5 py-3 rounded-lg text-xs font-mono uppercase tracking-widest font-bold bg-blue-600 hover:bg-blue-500 text-white transition-all shadow-lg shadow-blue-500/20 flex items-center gap-2 cursor-pointer\"\n            >\n              Explore Portfolio <ArrowRight size={13} />\n            </button>\n            <button\n              onClick={onExploreVision}\n              className=\"px-5 py-3 rounded-lg text-xs font-mono uppercase tracking-widest font-bold border border-slate-800 hover:border-slate-650 hover:bg-slate-850 text-slate-350 transition-all cursor-pointer\"\n            >\n              Architectural Mission\n            </button>\n          </div>\n\n          {/* Seed metrics counters (Architect metrics) */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-800/60 mt-4\">\n            <div>\n              <span className=\"block text-xl md:text-2xl font-black text-blue-400 font-sans\">11+ YRS</span>\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">Quality Blueprinting</span>\n            </div>\n            <div>\n              <span className=\"block text-xl md:text-2xl font-black text-indigo-400 font-sans\">OSS/BSS</span>\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">Core Domain Depth</span>\n            </div>\n            <div>\n              <span className=\"block text-xl md:text-2xl font-black text-sky-400 font-sans\">EU & US</span>\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">Carrier Stakeholders</span>\n            </div>\n            <div>\n              <span className=\"block text-xl md:text-2xl font-black text-emerald-400 font-sans\">CSPO APPROVED</span>\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">Certified Scrum Owner</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Right schematic visualization panel (Simulated interactive console terminal deck!) */}\n        <div className=\"lg:col-span-5 relative flex justify-center\">\n          <div className=\"w-full max-w-sm rounded-2xl border border-slate-800 bg-slate-950/75 p-5 shadow-2xl relative overflow-hidden space-y-4\">\n            \n            {/* System top status board */}\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800/80\">\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"w-2.5 h-2.5 rounded-full bg-red-500\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-yellow-501 bg-amber-500\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500\" />\n              </div>\n              <span className=\"text-[9.5px] font-mono tracking-widest text-slate-500 uppercase flex items-center gap-1\">\n                <Terminal size={10} /> console.trace\n              </span>\n            </div>\n\n            {/* Interactive Telemetry Tab buttons */}\n            <div className=\"grid grid-cols-3 gap-1 bg-slate-900/60 p-1 rounded-lg border border-slate-850\">\n              <button\n                onClick={() => handleTelemetrySelect(\"topology\")}\n                className={`py-1 shrink-0 rounded text-[9.5px] font-mono font-bold tracking-wider transition-all duration-200 cursor-pointer ${\n                  activeTelemetryTab === \"topology\"\n                    ? \"bg-blue-600 text-white shadow\"\n                    : \"text-slate-450 hover:text-slate-200 hover:bg-slate-850\"\n                }`}\n              >\n                TOPOLOGY_OSS\n              </button>\n              \n              <button\n                onClick={() => handleTelemetrySelect(\"billing\")}\n                className={`py-1 shrink-0 rounded text-[9.5px] font-mono font-bold tracking-wider transition-all duration-200 cursor-pointer ${\n                  activeTelemetryTab === \"billing\"\n                    ? \"bg-blue-600 text-white shadow\"\n                    : \"text-slate-450 hover:text-slate-200 hover:bg-slate-850\"\n                }`}\n              >\n                BILLING_BSS\n              </button>\n\n              <button\n                onClick={() => handleTelemetrySelect(\"sla\")}\n                className={`py-1 shrink-0 rounded text-[9.5px] font-mono font-bold tracking-wider transition-all duration-200 cursor-pointer ${\n                  activeTelemetryTab === \"sla\"\n                    ? \"bg-blue-600 text-white shadow\"\n                    : \"text-slate-450 hover:text-slate-200 hover:bg-slate-850\"\n                }`}\n              >\n                SLA_AUDIT\n              </button>\n            </div>\n\n            {/* Simulated Live Console logs underlay */}\n            <div className=\"p-3 bg-slate-950 rounded-lg border border-slate-900 space-y-1.5 min-h-[140px] font-mono text-[10px] text-slate-350 overflow-y-auto\">\n              {consoleLogs.map((log, index) => (\n                <div \n                  key={index} \n                  className={`leading-relaxed ${\n                    log.includes(\"\342\234\223\") || log.includes(\"SUCCESS\")\n                      ? \"text-emerald-400\" \n                      : log.includes(\"\342\235\257\") || log.includes(\"SYSTEM OVERVIEW\")\n                      ? \"text-blue-450 text-white font-bold\"\n                      : \"text-slate-400\"\n                  }`}\n                >\n                  {log}\n                </div>\n              ))}\n            </div>\n\n            {/* Active Action diagnostic simulation trigger */}\n            <div className=\"flex items-center justify-between gap-2.5 pt-1.5\">\n              <button\n                onClick={triggerSimulation}\n                disabled={isSimulating}\n                className=\"flex-grow py-2 px-3 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-300 hover:text-white text-[10.5px] font-mono tracking-wider flex items-center justify-center gap-1.5 disabled:opacity-50 cursor-pointer\"\n              >\n                <Zap size={11} className={isSimulating ? \"text-amber-400 animate-spin\" : \"text-sky-400\"} />\n                <span>{isSimulating ? \"RUNNING TELEMETRY...\" : \"FORCE DIAGNOSTICS\"}</span>\n              </button>\n            </div>\n\n            {/* Meta tags indicators */}\n            <div className=\"flex justify-between items-center text-[9px] text-slate-500 font-mono pt-1\">\n              <span>LOC: BENGALURU</span>\n              <span>ENGINE: TMF SID 21.0</span>\n            </div>\n            \n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
