    replacement_chunks {
      target_content: "                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1 text-[10.5px] font-mono text-slate-650 shrink-0\">\n                  <span className=\"flex items-center gap-1\"><Mail size={11} className=\"text-slate-500\" /> vetrivelm02@gmail.com</span>\n                  <span className=\"flex items-center gap-1\"><Smartphone size={11} className=\"text-slate-500\" /> +91 97XXXXXX73</span>\n                  <span className=\"flex items-center gap-1\"><Linkedin size={11} className=\"text-slate-500\" /> linkedin.com/in/vetrivelm</span>\n                  <span className=\"flex items-center gap-1\"><Globe size={11} className=\"text-slate-500\" /> Bengaluru, KA</span>\n                </div>\n              </div>\n\n              {/* Professional Profile */}\n              <div className=\"space-y-1.5\">\n                <h3 className=\"text-[11px] font-mono font-black text-slate-950 uppercase tracking-widest border-b border-slate-201 pb-1\">\n                  Professional Blueprint Executive Summary\n                </h3>\n                <p className=\"text-slate-700 leading-relaxed text-xs\">\n                  Versatile with over <strong>11 years</strong> of exhaustively validated enterprise domain expertise across Telecom operations support systems (OSS), subscriber business architectures (BSS), and partner middleware queues. Fusing full-stack Java/Spring-Boot/React capabilities with active Scrum methodologies (CSPO-certified), with direct background coordinating robust deliveries for major EU and US regional telecom carriers. Specialized in mapping complex business goals directly down into pristine, high-availability networks.\n                </p>\n              </div>\n\n              {/* Core Skill Matrix Grid */}\n              <div className=\"space-y-2\">\n                <h3 className=\"text-[11px] font-mono font-black text-slate-950 uppercase tracking-widest border-b border-slate-201 pb-1\">\n                  Validated Matrix Competencies\n                </h3>\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1\">\n                  <div className=\"space-y-1\">\n                    <span className=\"block text-[10px] font-mono text-slate-500 uppercase tracking-wider font-bold\">Systems & Telecom Core</span>\n                    <p className=\"text-slate-700 text-xs\">\n                      OSS/BSS Integration, Network topologies (NMS/EMS), TM Forum eTOM, TAM, SID representation frameworks, TM Forum Open APIs (630+), Billing engines (Aria & Amdocs API layers), SNMP, FCAPS standards.\n                    </p>\n                  </div>\n                  <div className=\"space-y-1 border-t sm:border-y-0 sm:border-x border-slate-100 sm:px-3 pt-2 sm:pt-0\">\n                    <span className=\"block text-[10px] font-mono text-slate-500 uppercase tracking-wider font-bold\">Engineering Stacks</span>\n                    <p className=\"text-slate-700 text-xs\">\n                      Java 21 / 17 (JDK Spring Boot 3.3 microservices), TypeScript, React 18 / 19, Kafka Streams, Docker containers, Kubernetes (AWS EKS orchestrations).\n                    </p>\n                  </div>\n                  <div className=\"space-y-1 border-t sm:border-t-0 pt-2 sm:pt-0\">\n                    <span className=\"block text-[10px] font-mono text-slate-500 uppercase tracking-wider font-bold\">QA & Agility Credentials</span>\n                    <p className=\"text-slate-700 text-xs\">\n                      Selenium test automation framework design, Test architecture and leadership (Capgemini), SLA analytics monitors, Certified Scrum Product Owner (CSPO).\n                    </p>\n                  </div>\n                </div>\n              </div>"
      replacement_content: "                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1 text-[10.5px] font-mono text-slate-650 shrink-0\">\n                  <span className=\"flex items-center gap-1\"><Mail size={11} className=\"text-slate-500\" /> vetrivelm02@gmail.com</span>\n                  <span className=\"flex items-center gap-1\"><Smartphone size={11} className=\"text-slate-500\" /> (+91) 9916008877</span>\n                  <span className=\"flex items-center gap-1\"><Linkedin size={11} className=\"text-slate-500\" /> linkedin.com/in/vetrivelm</span>\n                  <span className=\"flex items-center gap-1\"><Globe size={11} className=\"text-slate-500\" /> Bengaluru, India</span>\n                </div>\n              </div>\n\n              {/* Professional Profile */}\n              <div className=\"space-y-1.5\">\n                <h3 className=\"text-[11px] font-mono font-black text-slate-950 uppercase tracking-widest border-b border-slate-201 pb-1\">\n                  Professional Blueprint Executive Summary\n                </h3>\n                <p className=\"text-slate-700 leading-relaxed text-xs\">\n                  A highly skilled software engineer and test architect with over <strong>11 years</strong> of experience specializing in designing, developing, and deploying high-quality software solutions. Proficient in software testing, automation, billing engines, and agile methodologies. Consistently enhances operational efficiency, streamlines production pipelines, and possesses a proven track record of delivering complex telecommunications projects on time. Excellent at bridging technical, business, and client needs with robust, scalable, and maintainable products.\n                </p>\n              </div>\n\n              {/* Core Skill Matrix Grid */}\n              <div className=\"space-y-2\">\n                <h3 className=\"text-[11px] font-mono font-black text-slate-950 uppercase tracking-widest border-b border-slate-201 pb-1\">\n                  Validated Matrix Competencies\n                </h3>\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1\">\n                  <div className=\"space-y-1\">\n                    <span className=\"block text-[10px] font-mono text-slate-500 uppercase tracking-wider font-bold\">Systems & Telecom Core</span>\n                    <p className=\"text-slate-700 text-xs\">\n                      Telecom Billing (Singleview database table/structures, Aria & Amdocs API layers), 3GPP2 CDMA & 3GPP 5G/4G/3G/2G protocols, UE side (L1/L2/L3) Network Carrier Testing, LTE & 5G NR protocol testing.\n                    </p>\n                  </div>\n                  <div className=\"space-y-1 border-t sm:border-y-0 sm:border-x border-slate-100 sm:px-3 pt-2 sm:pt-0\">\n                    <span className=\"block text-[10px] font-mono text-slate-500 uppercase tracking-wider font-bold\">Project & Business Role</span>\n                    <p className=\"text-slate-700 text-xs\">\n                      Project Management, Agile Management, Scrum Master, Business Analyst, SDLC/STLC process definition, client support for UAT, incident investigation, release activities & production bill run validation.\n                    </p>\n                  </div>\n                  <div className=\"space-y-1 border-t sm:border-t-0 pt-2 sm:pt-0\">\n                    <span className=\"block text-[10px] font-mono text-slate-500 uppercase tracking-wider font-bold\">QA & Agility Credentials</span>\n                    <p className=\"text-slate-700 text-xs\">\n                      Selenium, Cypress, HP ALM, JIRA, QA bill run, revenue assurance metrics, Test architecture & leadership (Capgemini), Certified Scrum Product Owner (CSPO).\n                    </p>\n                  </div>\n                </div>\n              </div>"
    }
    instruction: "Update ResumeModal CV content with the exact work roles, descriptions, timelines, education history, contact details, and key skills from the user\'s official CV."
