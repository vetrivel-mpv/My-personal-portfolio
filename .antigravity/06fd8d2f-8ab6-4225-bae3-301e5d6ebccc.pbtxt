  file_change {
    absolute_path_uri: "file:///src/components/BlogSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useMemo } from \"react\";\nimport { BookOpen, Search, Clock, Calendar, ChevronRight, X } from \"lucide-react\";\nimport { BlogPost } from \"../types\";\n\ninterface BlogSectionProps {\n  blogs: BlogPost[];\n}\n\nexport default function BlogSection({ blogs }: BlogSectionProps) {\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [selectedPost, setSelectedPost] = useState<BlogPost | null>(null);\n\n  const publishedBlogs = useMemo(() => {\n    return blogs.filter((b) => b.status === \"published\");\n  }, [blogs]);\n\n  const filteredBlogs = useMemo(() => {\n    if (!searchQuery.trim()) return publishedBlogs;\n    const q = searchQuery.toLowerCase();\n    return publishedBlogs.filter(\n      (b) =>\n        b.title.toLowerCase().includes(q) ||\n        b.summary.toLowerCase().includes(q) ||\n        b.content.toLowerCase().includes(q) ||\n        b.category.toLowerCase().includes(q)\n    );\n  }, [publishedBlogs, searchQuery]);\n\n  const formattedDate = (isoString: string) => {\n    try {\n      const date = new Date(isoString);\n      return date.toLocaleDateString(\"en-US\", {\n        year: \"numeric\",\n        month: \"long\",\n        day: \"numeric\",\n      });\n    } catch (e) {\n      return \"June 2026\";\n    }\n  };\n\n  return (\n    <section id=\"reflections\" className=\"py-20 px-4 md:px-8 xl:px-12 bg-white dark:bg-slate-950 text-slate-850 dark:text-slate-100 transition-colors duration-300\">\n      <div className=\"max-w-4xl mx-auto space-y-12\">\n        {/* Header Title Section */}\n        <div className=\"space-y-4\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-8 h-[2px] bg-indigo-500\" />\n            <span className=\"font-mono text-xs text-indigo-500 uppercase tracking-widest font-semibold\">02 / BLOG & SYSTEM REFLECTIONS</span>\n          </div>\n          <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\">\n            <div>\n              <h2 className=\"text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight\">Recent Reflections</h2>\n              <p className=\"text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-lg\">\n                Thoughts, deep dives, and system learnings from an 11-year expedition through telecom infrastructure down to modern full-stack systems.\n              </p>\n            </div>\n\n            {/* Live Count badge */}\n            <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-indigo-50 dark:bg-indigo-950/10 border border-indigo-500/15 text-indigo-600 dark:text-indigo-400 text-xs font-mono font-medium self-start\">\n              <BookOpen size={13} />\n              <span>{filteredBlogs.length} Reflections Published</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Toolbar search option */}\n        <div className=\"relative max-w-md\">\n          <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500\" size={15} />\n          <input\n            type=\"text\"\n            id=\"blog-search-input\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search reflections, topics, or categories...\"\n            className=\"w-full pl-9 pr-4 py-2 text-xs font-sans rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all duration-200\"\n          />\n        </div>\n\n        {/* Reflections timeline items */}\n        {filteredBlogs.length > 0 ? (\n          <div className=\"space-y-6\">\n            {filteredBlogs.map((post) => (\n              <article\n                key={post.id}\n                onClick={() => setSelectedPost(post)}\n                className=\"group p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/40 border border-slate-200/50 dark:border-slate-850 hover:bg-slate-100/60 dark:hover:bg-slate-900/70 hover:border-indigo-500/30 dark:hover:border-indigo-500/30 transition-all duration-200 cursor-pointer\"\n              >\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 mb-3\">\n                  {/* Category */}\n                  <span className=\"inline-block px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-indigo-550/10 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400 font-semibold self-start sm:self-auto\">\n                    {post.category}\n                  </span>\n\n                  {/* Date & read time */}\n                  <div className=\"flex items-center gap-3 text-[10px] font-mono text-slate-400 dark:text-slate-500\">\n                    <span className=\"flex items-center gap-1\">\n                      <Calendar size={11} /> {formattedDate(post.createdAt)}\n                    </span>\n                    <span className=\"flex items-center gap-1\">\n                      <Clock size={11} /> {post.readTime}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Title and summary info */}\n                <div className=\"space-y-2\">\n                  <h3 className=\"text-lg font-bold text-slate-850 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200\">\n                    {post.title}\n                  </h3>\n                  <p className=\"text-xs text-slate-500 dark:text-slate-400 leading-relaxed max-w-2xl\">\n                    {post.summary}\n                  </p>\n                </div>\n\n                {/* Read indicator trigger */}\n                <div className=\"flex items-center gap-1 font-mono text-[10px] text-slate-400 dark:text-slate-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 pt-4 mt-2 border-t border-slate-100 dark:border-slate-800/40 transition-colors duration-200\">\n                  <span>READ REFLECTION</span>\n                  <ChevronRight size={12} className=\"group-hover:translate-x-1 duration-150\" />\n                </div>\n              </article>\n            ))}\n          </div>\n        ) : (\n          <div className=\"text-center py-16 bg-slate-50 dark:bg-slate-900/20 rounded-2xl border border-dashed border-slate-200 dark:border-slate-850\">\n            <BookOpen className=\"mx-auto text-slate-400 mb-2\" size={32} />\n            <h3 className=\"text-sm font-bold text-slate-700 dark:text-slate-400\">No reflections found</h3>\n            <p className=\"text-xs text-slate-400 mt-1 max-w-xs mx-auto\">\n              No matching posts found. Modify your search query to seek out individual topics.\n            </p>\n          </div>\n        )}\n\n        {/* Modal layout for reading one full reflection */}\n        {selectedPost && (\n          <div className=\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4\">\n            <div className=\"bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-850 rounded-2xl w-full max-w-2xl max-h-[85vh] overflow-y-auto p-6 md:p-8 space-y-6 relative animate-fade-up\">\n              \n              {/* Top button controls */}\n              <button\n                onClick={() => setSelectedPost(null)}\n                className=\"absolute top-4 right-4 w-8 h-8 rounded-full border border-slate-200 dark:border-slate-850 flex items-center justify-center text-slate-400 hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-900 cursor-pointer\"\n                title=\"Close\"\n              >\n                <X size={15} />\n              </button>\n\n              <div className=\"space-y-3\">\n                <span className=\"inline-block px-2.5 py-1 rounded text-[10px] font-mono uppercase bg-indigo-550/10 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400 font-semibold\">\n                  {selectedPost.category}\n                </span>\n\n                <h1 className=\"text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white leading-snug\">\n                  {selectedPost.title}\n                </h1>\n\n                <div className=\"flex items-center gap-4 text-xs font-mono text-slate-400 dark:text-slate-500 pt-1\">\n                  <span className=\"flex items-center gap-1\">\n                    <Calendar size={12} /> {formattedDate(selectedPost.createdAt)}\n                  </span>\n                  <span className=\"flex items-center gap-1\">\n                    <Clock size={12} /> {selectedPost.readTime}\n                  </span>\n                </div>\n              </div>\n\n              {/* Main article content - Styled with high elegance typography */}\n              <div className=\"prose dark:prose-invert prose-slate text-xs md:text-sm text-slate-650 dark:text-slate-300 leading-relaxed space-y-4 border-t border-slate-105 dark:border-slate-900 pt-6\">\n                {selectedPost.content.split(\"\\n\\n\").map((para, i) => {\n                  if (para.startsWith(\"## \")) {\n                    return (\n                      <h2 key={i} className=\"text-base md:text-lg font-bold text-slate-900 dark:text-white font-sans pt-2\">\n                        {para.replace(\"## \", \"\")}\n                      </h2>\n                    );\n                  }\n                  if (para.startsWith(\"### \")) {\n                    return (\n                      <h3 key={i} className=\"text-sm md:text-base font-bold text-slate-950 dark:text-white font-sans pt-1\">\n                        {para.replace(\"### \", \"\")}\n                      </h3>\n                    );\n                  }\n                  if (para.startsWith(\"* \")) {\n                    return (\n                      <ul key={i} className=\"list-disc pl-5 text-slate-600 dark:text-slate-400 space-y-1 text-xs\">\n                        {para.split(\"\\n\").map((line, li) => (\n                          <li key={li}>\n                            {line.substring(2).replace(/\\*\\*(.*?)\\*\\*/g, \"$1\").replace(/\\*(.*?)\\*/g, \"$1\")}\n                          </li>\n                        ))}\n                      </ul>\n                    );\n                  }\n                  \n                  // Render formatting highlights within custom paragraphs\n                  const formattedText = para.replace(/\\*\\*(.*?)\\*\\*/g, \"<strong>$1</strong>\").replace(/\\*(.*?)\\*/g, \"<em>$1</em>\");\n                  return (\n                    <p\n                      key={i}\n                      dangerouslySetInnerHTML={{ __html: formattedText }}\n                      className=\"text-slate-600 dark:text-slate-300\"\n                    />\n                  );\n                })}\n              </div>\n\n              {/* Read completion triggers footer */}\n              <div className=\"pt-6 border-t border-slate-100 dark:border-slate-900 flex justify-end\">\n                <button\n                  onClick={() => setSelectedPost(null)}\n                  className=\"px-4 py-2 rounded-lg text-xs font-mono tracking-wider font-semibold bg-slate-150 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer\"\n                >\n                  DISMISS\n                </button>\n              </div>\n\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n"
    }
