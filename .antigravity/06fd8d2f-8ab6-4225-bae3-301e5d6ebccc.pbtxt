      replacement_content: "        {/* Theme switcher dropdown */}\n        <div className=\"relative\" id=\"theme-switcher-wrapper\">\n          <button\n            onClick={() => setIsThemeMenuOpen(!isThemeMenuOpen)}\n            id=\"theme-toggle-btn\"\n            title=\"Change color theme mode\"\n            className=\"h-8 px-2.5 rounded-lg flex items-center gap-1.5 border border-slate-200 dark:border-slate-800 text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors duration-200 text-xs font-mono cursor-pointer\"\n          >\n            {themeMode === \"light\" && <Sun size={14} className=\"text-amber-505 text-amber-500\" />}\n            {themeMode === \"dark\" && <Moon size={14} className=\"text-indigo-400\" />}\n            {themeMode === \"system\" && <Monitor size={14} className=\"text-emerald-400\" />}\n            <span className=\"uppercase text-[10px] tracking-wider hidden sm:inline\">{themeMode}</span>\n            <ChevronDown size={11} className={`opacity-60 transition-transform duration-200 ${isThemeMenuOpen ? \"rotate-180\" : \"\"}`} />\n          </button>\n\n          {isThemeMenuOpen && (\n            <>\n              {/* Overlay transparent backdrop to allow closing by clicking outside */}\n              <div \n                className=\"fixed inset-0 z-45 cursor-default\" \n                onClick={() => setIsThemeMenuOpen(false)} \n              />\n              <div \n                id=\"theme-menu-dropdown\"\n                className=\"absolute right-0 mt-1.5 w-32 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 p-1.5 shadow-xl font-mono text-[11px] z-50 space-y-0.5\"\n              >\n                <button\n                  onClick={() => {\n                    setThemeMode(\"light\");\n                    setIsThemeMenuOpen(false);\n                  }}\n                  className={`w-full flex items-center gap-2 px-2 py-1.5 rounded-lg text-left transition-colors cursor-pointer ${\n                    themeMode === \"light\"\n                      ? \"bg-blue-500/10 text-blue-600 dark:text-sky-450 font-bold\"\n                      : \"text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-900\"\n                  }`}\n                >\n                  <Sun size={13} className=\"text-amber-500\" />\n                  <span>Light</span>\n                </button>\n\n                <button\n                  onClick={() => {\n                    setThemeMode(\"dark\");\n                    setIsThemeMenuOpen(false);\n                  }}\n                  className={`w-full flex items-center gap-2 px-2 py-1.5 rounded-lg text-left transition-colors cursor-pointer ${\n                    themeMode === \"dark\"\n                      ? \"bg-blue-500/10 text-blue-600 dark:text-sky-450 font-bold\"\n                      : \"text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-900\"\n                  }`}\n                >\n                  <Moon size={13} className=\"text-indigo-450 text-indigo-400\" />\n                  <span>Dark</span>\n                </button>\n\n                <button\n                  onClick={() => {\n                    setThemeMode(\"system\");\n                    setIsThemeMenuOpen(false);\n                  }}\n                  className={`w-full flex items-center gap-2 px-2 py-1.5 rounded-lg text-left transition-colors cursor-pointer ${\n                    themeMode === \"system\"\n                      ? \"bg-blue-500/10 text-blue-600 dark:text-sky-450 font-bold\"\n                      : \"text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-900\"\n                  }`}\n                >\n                  <Monitor size={13} className=\"text-emerald-400\" />\n                  <span>System</span>\n                </button>\n              </div>\n            </>\n      