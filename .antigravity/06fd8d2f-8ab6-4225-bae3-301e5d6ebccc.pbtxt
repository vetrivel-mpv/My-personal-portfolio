  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \"react\";\nimport { Terminal, Sun, Moon, Lock, Unlock, Eye } from \"lucide-react\";\n\ninterface NavbarProps {\n  onAdminToggle: () => void;\n  isAdminMode: boolean;\n  onViewAsVisitor: () => void;\n}\n\nexport default function Navbar({ onAdminToggle, isAdminMode, onViewAsVisitor }: NavbarProps) {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [isDark, setIsDark] = useState(() => {\n    const saved = localStorage.getItem(\"vetrivel_portfolio_theme\");\n    if (saved) return saved === \"dark\";\n    return true; // default dark mode for premium look\n  });\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 15);\n    };\n    window.addEventListener(\"scroll\", handleScroll);\n    return () => window.removeEventListener(\"scroll\", handleScroll);\n  }, []);\n\n  useEffect(() => {\n    const root = document.documentElement;\n    if (isDark) {\n      root.classList.add(\"dark\");\n      localStorage.setItem(\"vetrivel_portfolio_theme\", \"dark\");\n    } else {\n      root.classList.remove(\"dark\");\n      localStorage.setItem(\"vetrivel_portfolio_theme\", \"light\");\n    }\n  }, [isDark]);\n\n  return (\n    <nav\n      id=\"portfolio-navbar\"\n      className={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 h-16 flex items-center justify-between px-4 md:px-8 border-b ${\n        isScrolled\n          ? \"bg-slate-950/85 dark:bg-slate-950/85 light:bg-white/90 backdrop-blur-md border-slate-200/10 dark:border-slate-800/60 shadow-lg\"\n          : \"bg-transparent border-transparent\"\n      }`}\n    >\n      <div className=\"flex items-center gap-3\">\n        <a href=\"#home\" className=\"flex items-center gap-2 group\">\n          <div className=\"w-9 h-9 text-xs font-mono font-bold bg-gradient-to-br from-blue-500 to-indigo-600 dark:from-sky-400 dark:to-indigo-500 text-white rounded-lg flex items-center justify-center shadow-md shadow-blue-500/15 group-hover:scale-105 transition-transform duration-200\">\n            VM\n          </div>\n          <span className=\"font-sans font-extrabold text-sm tracking-tight text-slate-800 dark:text-slate-100 dark:group-hover:text-sky-400 group-hover:text-blue-600 transition-colors duration-200\">\n            vetrivel.arch\n          </span>\n        </a>\n      </div>\n\n      {/* Nav Links */}\n      <div className=\"hidden md:flex items-center gap-1\">\n        <a\n          href=\"#home\"\n          className=\"px-3 py-1.5 rounded-lg text-xs font-mono tracking-wider font-medium text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-900/60 transition-all duration-200\"\n        >\n          story\n        </a>\n        <a\n          href=\"#projects\"\n          className=\"px-3 py-1.5 rounded-lg text-xs font-mono tracking-wider font-medium text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-900/60 transition-all duration-200\"\n        >\n          showcase\n        </a>\n        <a\n          href=\"#reflections\"\n          className=\"px-3 py-1.5 rounded-lg text-xs font-mono tracking-wider font-medium text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-900/60 transition-all duration-200\"\n        >\n          reflections\n        </a>\n        <a\n          href=\"#contact\"\n          className=\"px-3 py-1.5 rounded-lg text-xs font-mono tracking-wider font-medium text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-900/60 transition-all duration-200\"\n        >\n          contact\n        </a>\n      </div>\n\n      {/* Toggles & Admin triggers */}\n      <div className=\"flex items-center gap-3\">\n        {/* Active indicators */}\n        <div className=\"hidden lg:flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 dark:bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[10px] font-mono tracking-wider\">\n          <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\" />\n          AVAILABLE FOR LEAD ROLES\n        </div>\n\n        {/* Theme toggle */}\n        <button\n          onClick={() => setIsDark(!isDark)}\n          id=\"theme-toggle-btn\"\n          title=\"Toggle color scheme\"\n          className=\"w-8 h-8 rounded-lg flex items-center justify-center border border-slate-200 dark:border-slate-800 text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors duration-200\"\n        >\n          {isDark ? <Sun size={15} /> : <Moon size={15} />}\n        </button>\n\n        {/* Administration quick trigger */}\n        {isAdminMode ? (\n          <button\n            onClick={onViewAsVisitor}\n            id=\"visitor-view-btn\"\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-indigo-500/30 bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-500/15 text-[11px] font-mono font-medium tracking-wide transition-all duration-200\"\n          >\n            <Eye size={13} />\n            <span>VISITOR VIEW</span>\n          </button>\n        ) : (\n          <button\n            onClick={onAdminToggle}\n            id=\"admin-dashboard-toggle-btn\"\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:text-indigo-500 dark:hover:text-indigo-400 hover:bg-indigo-500/5 text-[11px] font-mono tracking-wide transition-all duration-200\"\n          >\n            <Lock size={12} className=\"text-slate-400 dark:text-slate-500\" />\n            <span>CONSOLE</span>\n          </button>\n        )}\n      </div>\n    </nav>\n  );\n}\n"
    }
