    replacement_chunks {
      target_content: ".animate-scale-up {\n  animation: scaleUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}"
      replacement_content: ".animate-scale-up {\n  animation: scaleUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n/* ==========================================\n   Theme Transition & Micro-interaction Classes\n   =========================================== */\n\n/* Global smooth transition when changing stylesheet states (Light/Dark mode) */\nbody, section, nav, footer, div, button, p, span, h1, h2, h3, h4, h5, h6, input, textarea, select {\n  transition: background-color 400ms cubic-bezier(0.4, 0, 0.2, 1), \n              border-color 400ms cubic-bezier(0.4, 0, 0.2, 1), \n              color 400ms cubic-bezier(0.4, 0, 0.2, 1), \n              box-shadow 400ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Custom rotate keyframe for dark/light mode toggle */\n@keyframes theme-toggle-rotate {\n  0% {\n    transform: rotate(-180deg) scale(0.5);\n    opacity: 0;\n  }\n  15% {\n    opacity: 0.5;\n  }\n  100% {\n    transform: rotate(0deg) scale(1);\n    opacity: 1;\n  }\n}\n\n.theme-icon-animate {\n  animation: theme-toggle-rotate 450ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n}\n\n\n/* ==========================================\n   Advanced PDF & Document Print Stylesheet\n   =========================================== */\n\n@media print {\n  /* 1. Hide interactive components, chatbots, dropdowns, and dashboard controllers */\n  #portfolio-navbar,\n  #ai-chatbot-window,\n  #ai-chatbot-toggle-button,\n  #theme-toggle-btn,\n  #theme-menu-dropdown,\n  #admin-dashboard-toggle-btn,\n  #visitor-view-btn,\n  .no-print,\n  button,\n  input,\n  textarea,\n  iframe,\n  [role=\"button\"] {\n    display: none !important;\n  }\n\n  /* 2. Reset full viewport background colors & ink contrasts for standard paper sizing */\n  html, body {\n    background: #ffffff !important;\n    background-color: #ffffff !important;\n    color: #1e293b !important; /* Deep slate ink standard typography */\n    font-size: 11pt !important;\n    line-height: 1.5 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    width: 100% !important;\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n\n  /* 3. Adjust page margins and eliminate top headers gaps */\n  main {\n    padding-top: 0 !important;\n    margin: 1.2cm !important;\n  }\n\n  html {\n    overflow: visible !important;\n  }\n\n  /* 4. Disable heavy gradient background lights and dark visual elements */\n  .blur-\\[130px\\],\n  .absolute,\n  .bg-gradient-to-r,\n  .bg-gradient-to-b {\n    background-image: none !important;\n    background: none !important;\n    filter: none !important;\n    box-shadow: none !important;\n  }\n\n  /* 5. Force text headings to dark colors and avoid breaking mid-page elements */\n  h1, h2, h3, h4, h5, h6 {\n    color: #0f172a !important;\n    page-break-after: avoid !important;\n    page-break-inside: avoid !important;\n    break-after: avoid !important;\n  }\n\n  p, span, li, tr {\n    page-break-inside: avoid !important;\n    break-inside: avoid !important;\n  }\n\n  /* 6. Prevent print breaks from slicing multi-columns sections */\n  section,\n  article,\n  .rounded-3xl,\n  #skills-analytics-section,\n  #vision-section,\n  #projects,\n  .group {\n    page-break-inside: avoid !important;\n    break-inside: avoid !important;\n    margin-bottom: 20pt !important;\n    background: #ffffff !important;\n    border: 1.5px solid #eaeaea !important;\n    box-shadow: none !important;\n  }\n\n  /* 7. Unroll standard grid containers into unified single-column vertical outlines */\n  .grid {\n    display: block !important;\n  }\n\n  .lg\\:grid-cols-12,\n  .grid-cols-1,\n  .grid-cols-2,\n  .grid-cols-3,\n  .md\\:grid-cols-2 {\n    display: block !important;\n  }\n\n  /* 8. Show full original Web URL strings next to high-priority clickable anchors for offline reference */\n  a[href^=\"http\"]:after {\n    content: \" (\" attr(href) \")\" !important;\n    font-size: 8.5pt !important;\n    color: #475569 !important;\n    text-decoration: underline !important;\n  }\n}\n"
    }
