    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { ArrowRight, Terminal, Cloud, Layers, Award, ShieldAlert } from \"lucide-react\";\n\ninterface HeroProps {\n  onExploreProjects: () => void;\n  onExploreVision: () => void;\n}\n\nexport default function Hero({ onExploreProjects, onExploreVision }: HeroProps) {\n  return (\n    <section\n      id=\"home\"\n      className=\"relative min-h-[92vh] flex items-center pt-24 pb-16 px-4 md:px-8 xl:px-12 overflow-hidden bg-slate-900 text-slate-100 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-300\"\n    >\n      {/* Dynamic Background Grid and Radial Gradient Mesh */}\n      <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#0f172a_1px,transparent_1px),linear-gradient(to_bottom,#0f172a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-35 dark:opacity-20 pointer-events-none\" />\n      <div className=\"absolute top-10 right-[-10%] w-[500px] h-[550px] rounded-full bg-blue-500/10 dark:bg-sky-500/5 blur-[120px] pointer-events-none\" />\n      <div className=\"absolute bottom-[-10%] left-[-5%] w-[450px] h-[450px] rounded-full bg-violet-600/10 dark:bg-indigo-600/5 blur-[100px] pointer-events-none\" />\n\n      <div className=\"max-w-6xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10\">\n        \n        {/* Left main presentation panel */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          <div className=\"inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-blue-500/10 dark:bg-sky-500/10 border border-blue-500/20 text-blue-600 dark:text-sky-400 text-xs font-mono font-medium tracking-wide\">\n            <span className=\"flex h-2 w-2 relative\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-blue-500\"></span>\n            </span>\n            SYSTEMS & SOLUTION ARCHITECTURE BLUEPRINT\n          </div>\n\n          <div className=\"space-y-2\">\n            <h1 className=\"text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight\">\n              Vetrivel <span className=\"bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent\">Muthusamy</span>\n            </h1>\n            <p className=\"text-lg md:text-xl font-mono text-slate-300 dark:text-sky-300/85\">\n              Test Architect & Lead <span className=\"text-blue-500\">\342\206\222</span> Solution Architect\n            </p>\n          </div>\n\n          <p className=\"text-sm md:text-base text-slate-400 leading-relaxed max-w-xl\">\n            Leveraging **11+ years** of end-to-end domain precision in telecom OSS/BSS platforms. Rooted in systems validation across Europe and the US, reinforced with full-stack development capability (Java/Spring/React), aiming to architect the next era of fault-tolerant carrier systems.\n          </p>\n\n          {/* Quick interactive career visual tracks */}\n          <div className=\"flex flex-wrap items-center gap-2 pt-2\">\n            <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">My Path:</span>\n            <span className=\"text-xs font-mono px-2.5 py-1 rounded bg-slate-800 text-slate-400\">QA Engineer</span>\n            <span className=\"text-xs text-slate-600\">\342\206\222</span>\n            <span className=\"text-xs font-mono px-2.5 py-1 rounded bg-slate-800 text-slate-400\">Full Stack Dev</span>\n            <span className=\"text-xs text-slate-600\">\342\206\222</span>\n            <span className=\"text-xs font-mono px-2.5 py-1 rounded bg-slate-800 text-slate-400\">Test Architect & Lead</span>\n            <span className=\"text-xs text-slate-600\">\342\206\222</span>\n            <span className=\"text-xs font-mono px-2.5 py-1 bg-gradient-to-r from-blue-500 to-violet-600 text-white rounded font-semibold shadow-md\">Solution Architect</span>\n          </div>\n\n          {/* CTA triggers */}\n          <div className=\"flex flex-wrap items-center gap-3 pt-4\">\n            <button\n              onClick={onExploreProjects}\n              className=\"px-5 py-3 rounded-lg text-xs font-mono uppercase tracking-widest font-bold bg-gradient-to-r from-blue-500 to-indigo-600 text-white hover:opacity-95 transition-all shadow-lg shadow-blue-500/20 flex items-center gap-2 cursor-pointer\"\n            >\n              Explore Showcase <ArrowRight size={14} />\n            </button>\n            <button\n              onClick={onExploreVision}\n              className=\"px-5 py-3 rounded-lg text-xs font-mono uppercase tracking-widest font-bold border border-slate-700 hover:border-slate-500 hover:bg-slate-800 text-slate-300 transition-all cursor-pointer\"\n            >\n              Architectural Vision\n            </button>\n          </div>\n\n          {/* Seed metrics counters */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-slate-800 mt-8\">\n            <div className=\"bg-slate-900/50 p-3 rounded-xl border border-slate-800\">\n              <span className=\"block text-xl md:text-2xl font-extrabold text-blue-400\">11+</span>\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">Years Experience</span>\n            </div>\n            <div className=\"bg-slate-900/50 p-3 rounded-xl border border-slate-800\">\n              <span className=\"block text-xl md:text-2xl font-extrabold text-indigo-400\">OSS/BSS</span>\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">Domain Depth</span>\n            </div>\n            <div className=\"bg-slate-900/50 p-3 rounded-xl border border-slate-800\">\n              <span className=\"block text-xl md:text-2xl font-extrabold text-violet-400\">EU & US</span>\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">Stakeholders Served</span>\n            </div>\n            <div className=\"bg-slate-900/50 p-3 rounded-xl border border-slate-800\">\n              <span className=\"block text-xl md:text-2xl font-extrabold text-emerald-400\">CSPO</span>\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500\">Certified Agile</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Right schematic visualization panel */}\n        <div className=\"lg:col-span-5 relative flex justify-center\">\n          <div className=\"w-full max-w-sm rounded-2xl border border-slate-800 bg-slate-950/60 p-5 shadow-2xl relative overflow-hidden space-y-4\">\n            \n            {/* System console prompt look */}\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"w-2.5 h-2.5 rounded-full bg-red-500/80\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-yellow-500/80\" />\n                <span className=\"w-2.5 h-2.5 rounded-full bg-green-500/80\" />\n              </div>\n              <span className=\"text-[9px] font-mono tracking-widest text-slate-500 uppercase\">vetrivel_arch_telemetry</span>\n            </div>\n\n            {/* Simulated Live telemetry nodes */}\n            <div className=\"space-y-3 font-mono text-xs\">\n              <div className=\"flex justify-between items-center text-slate-400 bg-slate-900/65 px-3 py-2 rounded-lg border border-slate-800/60\">\n                <span className=\"flex items-center gap-1.5 text-[11px]\">\n                  <Layers size={12} className=\"text-blue-400\" /> OSS Network Topology\n                </span>\n                <span className=\"text-[11px] text-emerald-400 font-bold\">READY</span>\n              </div>\n              \n              <div className=\"flex justify-between items-center text-slate-400 bg-slate-900/65 px-3 py-2 rounded-lg border border-slate-800/60\">\n                <span className=\"flex items-center gap-1.5 text-[11px]\">\n                  <Cloud size={12} className=\"text-violet-400\" /> BSS Subscriber API\n                </span>\n                <span className=\"text-[11px] text-indigo-400\">SECURE [SSL]</span>\n              </div>\n\n              <div className=\"flex justify-between items-center text-slate-400 bg-slate-900/65 px-3 py-2 rounded-lg border border-slate-800/60\">\n                <span className=\"flex items-center gap-1.5 text-[11px]\">\n                  <Award size={12} className=\"text-indigo-400\" /> SLA Assurance Rules\n                </span>\n                <span className=\"text-[11px] text-sky-400 font-bold\">100% GREEN</span>\n              </div>\n            </div>\n\n            {/* Dynamic Architecture Visual Cards */}\n            <div className=\"bg-slate-900/40 p-4 rounded-xl border border-slate-800/80 space-y-3\">\n              <div className=\"text-[10px] font-mono text-slate-400 tracking-wider\">\n                # VETRIVEL CORE SOLUTION METRICS\n              </div>\n              <div className=\"space-y-1.5 text-[11px] text-slate-300\">\n                <p>\342\235\257 <strong className=\"text-white\">Liverpool John Moores</strong> - MS CS</p>\n                <p>\342\235\257 <strong className=\"text-white\">Bharathidasan University</strong> - BCA</p>\n                <p>\342\235\257 <strong className=\"text-white\">Active CSPO Certificate</strong> - Scrum Alliance</p>\n              </div>\n            </div>\n\n            {/* System Status and Location */}\n            <div className=\"flex justify-between items-center text-[10px] text-slate-500 font-mono\">\n              <span>LOCATION: BENGALURU</span>\n              <span>TIMEZONE: GMT+5:30</span>\n            </div>\n            \n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
