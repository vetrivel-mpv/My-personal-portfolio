  file_change {
    absolute_path_uri: "file:///src/components/Milestones.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  History, \n  TrendingUp, \n  Cpu, \n  Activity, \n  Sliders, \n  CheckCircle, \n  AlertTriangle \n} from \"lucide-react\";\nimport {\n  ResponsiveContainer,\n  AreaChart,\n  Area,\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  Tooltip,\n  CartesianGrid,\n  Legend\n} from \"recharts\";\n\n// Static high-fidelity dataset tracking real career trajectory metrics\nconst growthTimelineData = [\n  {\n    year: \"2014\",\n    stage: \"Telecom Analyst\",\n    verifiedEndpoints: 15,\n    automatedTestCases: 150,\n    carrierSubscribersM: 2.5\n  },\n  {\n    year: \"2016\",\n    stage: \"QA Lead\",\n    verifiedEndpoints: 45,\n    automatedTestCases: 480,\n    carrierSubscribersM: 10.0\n  },\n  {\n    year: \"2019\",\n    stage: \"Lead QA Specialist\",\n    verifiedEndpoints: 90,\n    automatedTestCases: 1250,\n    carrierSubscribersM: 24.5\n  },\n  {\n    year: \"2022\",\n    stage: \"Test Architect\",\n    verifiedEndpoints: 160,\n    automatedTestCases: 2900,\n    carrierSubscribersM: 52.0\n  },\n  {\n    year: \"2026\",\n    stage: \"Solution Architect\",\n    verifiedEndpoints: 250,\n    automatedTestCases: 4500,\n    carrierSubscribersM: 85.0\n  }\n];\n\nconst efficiencyImpactData = [\n  {\n    metric: \"Selenium/Cypress Automation %\",\n    beforeSkill: 20,\n    afterArchitect: 98,\n    unit: \"%\"\n  },\n  {\n    metric: \"Regression Script Speed (Fold Test)\",\n    beforeSkill: 1, // baseline\n    afterArchitect: 6.5, // 6.5x faster\n    unit: \"x\"\n  },\n  {\n    metric: \"Integration Leakage Incidents Cut\",\n    beforeSkill: 35, // legacy bugs\n    afterArchitect: 0.5, // less than 0.5% defect rate\n    unit: \"%\"\n  },\n  {\n    metric: \"Active Endpoints SLA (Days/Update)\",\n    beforeSkill: 14, // slow releases\n    afterArchitect: 1, // atomic continuous deployments\n    unit: \"Days\"\n  }\n];\n\nexport default function Milestones() {\n  const [activeTab, setActiveTab] = useState<\"growth\" | \"metrics\">(\"growth\");\n\n  // Custom tooltips to match our clean, high-contrast dark and light modes\n  const CustomTimelineTooltip = ({ active, payload, label }: any) => {\n    if (active && payload && payload.length) {\n      const data = payload[0].payload;\n      return (\n        <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl shadow-xl font-mono text-[11px] text-slate-800 dark:text-slate-100 max-w-[280px]\">\n          <div className=\"text-blue-500 dark:text-sky-400 font-bold uppercase tracking-wider text-xs border-b border-slate-200 dark:border-slate-800 pb-1.5 mb-1.5\">\n            Phase: {data.stage} ({data.year})\n          </div>\n          <div className=\"space-y-1\">\n            <p className=\"flex justify-between gap-4\">\n              <span>Managed OSS Endpoints:</span>\n              <strong className=\"text-slate-900 dark:text-white font-sans\">{data.verifiedEndpoints} nodes</strong>\n            </p>\n            <p className=\"flex justify-between gap-4\">\n              <span>Automated Test Matrix:</span>\n              <strong className=\"text-slate-900 dark:text-white font-sans\">{data.automatedTestCases} scripts</strong>\n            </p>\n            <p className=\"flex justify-between gap-4\">\n              <span>Subscriber Base Coverage:</span>\n              <strong className=\"text-slate-900 dark:text-white font-sans\">{data.carrierSubscribersM}M users</strong>\n            </p>\n          </div>\n        </div>\n      );\n    }\n    return null;\n  };\n\n  const CustomImpactTooltip = ({ active, payload, label }: any) => {\n    if (active && payload && payload.length) {\n      const data = payload[0].payload;\n      return (\n        <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 rounded-xl shadow-xl font-mono text-[11px] text-slate-800 dark:text-slate-100 max-w-[280px]\">\n          <div className=\"text-blue-500 dark:text-sky-400 font-bold uppercase tracking-wider text-xs border-b border-slate-201 dark:border-slate-800 pb-1.5 mb-1.5 leading-tight\">\n            {data.metric}\n          </div>\n          <div className=\"space-y-1\">\n            <p className=\"flex justify-between gap-4\">\n              <span>Legacy Industry Standard:</span>\n              <span className=\"text-slate-500 line-through font-sans\">{data.beforeSkill}{data.unit}</span>\n            </p>\n            <p className=\"flex justify-between gap-4\">\n              <span>Vetrivel\'s Unified Architecture:</span>\n              <strong className=\"text-emerald-500 font-sans\">{data.afterArchitect}{data.unit}</strong>\n            </p>\n          </div>\n        </div>\n      );\n    }\n    return null;\n  };\n\n  return (\n    <section \n      id=\"milestones-analytics\"\n      className=\"py-20 px-4 md:px-8 xl:px-12 bg-slate-55 dark:bg-slate-950 text-slate-800 dark:text-slate-100 border-t border-b border-slate-200 dark:border-slate-900 transition-colors duration-300\"\n    >\n      <div className=\"max-w-6xl mx-auto space-y-10\">\n        \n        {/* Title and control block */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6\">\n          <div className=\"space-y-3.5\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-8 h-[2px] bg-blue-500\" />\n              <span className=\"font-mono text-xs text-blue-500 uppercase tracking-widest font-semibold\">01 / TRAJECTORY ANALYTICS</span>\n            </div>\n            <h2 className=\"text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight\">\n              A Decade of Proven Delivery Impact\n            </h2>\n            <p className=\"text-sm text-slate-500 dark:text-slate-450 max-w-xl leading-relaxed\">\n              Interactive visualization models showcasing core systems telemetry growth, test coverage scaling ratios, and efficiency optimizations achieved across European/US carriers.\n            </p>\n          </div>\n\n          {/* Tab Selector Switches */}\n          <div className=\"flex gap-1.5 bg-slate-200/50 dark:bg-slate-900 p-1 rounded-xl border border-slate-300/30 dark:border-slate-800 w-fit shrink-0 relative z-10\">\n            <button\n              onClick={() => setActiveTab(\"growth\")}\n              className={`flex items-center gap-2 py-2 px-4 rounded-lg text-xs font-mono font-bold uppercase transition-all duration-200 cursor-pointer ${\n                activeTab === \"growth\"\n                  ? \"bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm\"\n                  : \"text-slate-500 hover:text-slate-800 dark:hover:text-slate-350\"\n              }`}\n            >\n              <History size={13} className={activeTab === \"growth\" ? \"text-blue-500\" : \"\"} />\n              <span>Career Growth Timeline</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\"metrics\")}\n              className={`flex items-center gap-2 py-2 px-4 rounded-lg text-xs font-mono font-bold uppercase transition-all duration-200 cursor-pointer ${\n                activeTab === \"metrics\"\n                  ? \"bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm\"\n                  : \"text-slate-500 hover:text-slate-800 dark:hover:text-slate-350\"\n              }`}\n            >\n              <TrendingUp size={13} className={activeTab === \"metrics\" ? \"text-blue-500\" : \"\"} />\n              <span>Key Project Impacts</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Dynamic Display area containing the Recharts models */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          {/* Chart Wrapper (takes 8 cols) */}\n          <div className=\"lg:col-span-8 bg-white dark:bg-slate-900/60 p-5 md:p-6 rounded-2xl border border-slate-200/80 dark:border-slate-850 shadow-sm flex flex-col justify-between\">\n            <div className=\"pb-4 border-b border-slate-100 dark:border-slate-850 mb-6 flex justify-between items-center\">\n              <span className=\"text-[10px] font-mono tracking-wider uppercase text-slate-400 dark:text-slate-550 flex items-center gap-1.5 font-bold\">\n                <Activity size={12} className=\"text-blue-500\" /> Live Interactive Recharts Model\n              </span>\n              <span className=\"text-[10px] font-mono text-emerald-400 bg-emerald-500/10 dark:bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 uppercase font-black tracking-wide\">\n                Synced Dynamic Engine\n              </span>\n            </div>\n\n            <div className=\"w-full h-[320px] relative z-10\">\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                {activeTab === \"growth\" ? (\n                  <AreaChart\n                    data={growthTimelineData}\n                    margin={{ top: 10, right: 10, left: -20, bottom: 5 }}\n                  >\n                    <defs>\n                      <linearGradient id=\"colorEndpoints\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"5%\" stopColor=\"#3b82f6\" stopOpacity={0.25}/>\n                        <stop offset=\"95%\" stopColor=\"#3b82f6\" stopOpacity={0.0}/>\n                      </linearGradient>\n                      <linearGradient id=\"colorTests\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"5%\" stopColor=\"#6366f1\" stopOpacity={0.2}/>\n                        <stop offset=\"95%\" stopColor=\"#6366f1\" stopOpacity={0.0}/>\n                      </linearGradient>\n                    </defs>\n                    <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e2e8f0\" className=\"dark:stroke-slate-800\" />\n                    <XAxis \n                      dataKey=\"year\" \n                      tick={{ fontSize: 10, fontFamily: \"monospace\" }} \n                      stroke=\"#94a3b8\"\n                    />\n                    <YAxis \n                      tick={{ fontSize: 10, fontFamily: \"monospace\" }} \n                      stroke=\"#94a3b8\"\n                    />\n                    <Tooltip content={<CustomTimelineTooltip />} />\n                    <Legend \n                      verticalAlign=\"top\" \n                      height={36} \n                      iconType=\"circle\"\n                      wrapperStyle={{ fontSize: \"11px\", fontFamily: \"monospace\" }}\n                    />\n                    <Area \n                      type=\"monotone\" \n                      name=\"OSS Endpoints Verified\" \n                      dataKey=\"verifiedEndpoints\" \n                      stroke=\"#3b82f6\" \n                      strokeWidth={2.5}\n                      fillOpacity={1} \n                      fill=\"url(#colorEndpoints)\" \n                    />\n                    <Area \n                      type=\"monotone\" \n                      name=\"Automated Test Suites\" \n                      dataKey=\"automatedTestCases\" \n                      stroke=\"#6366f1\" \n                      strokeWidth={2}\n                      fillOpacity={1} \n                      fill=\"url(#colorTests)\" \n                    />\n                  </AreaChart>\n                ) : (\n                  <BarChart\n                    data={efficiencyImpactData}\n                    margin={{ top: 15, right: 10, left: -20, bottom: 5 }}\n                  >\n                    <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e2e8f0\" className=\"dark:stroke-slate-800\" />\n                    <XAxis \n                      dataKey=\"metric\" \n                      tick={{ fontSize: 9, fontFamily: \"monospace\", width: 140 }} \n                      stroke=\"#94a3b8\" \n                    />\n                    <YAxis \n                      tick={{ fontSize: 10, fontFamily: \"monospace\" }} \n                      stroke=\"#94a3b8\"\n                    />\n                    <Tooltip content={<CustomImpactTooltip />} />\n                    <Legend \n                      verticalAlign=\"top\" \n                      height={36} \n                      iconType=\"square\"\n                      wrapperStyle={{ fontSize: \"11px\", fontFamily: \"monospace\" }}\n                    />\n                    <Bar \n                      name=\"Legacy Process Baseline\" \n                      dataKey=\"beforeSkill\" \n                      fill=\"#94a3b8\" \n                      radius={[4, 4, 0, 0]} \n                      maxBarSize={45}\n                    />\n                    <Bar \n                      name=\"Architect-Driven Target\" \n                      dataKey=\"afterArchitect\" \n                      fill=\"#10b981\" \n                      radius={[4, 4, 0, 0]} \n                      maxBarSize={45}\n                    />\n                  </BarChart>\n                )}\n              </ResponsiveContainer>\n            </div>\n            \n            <p className=\"text-[10.5px] text-slate-400 dark:text-slate-500 font-mono mt-4 leading-normal\">\n              * Note: Values displayed represent cumulative system integration counts & automation scaling validated over major European & US telecommunication service contract rollouts.\n            </p>\n          </div>\n\n          {/* Quick-Stats Metrics Readout Cards (takes 4 cols) */}\n          <div className=\"lg:col-span-4 flex flex-col justify-between gap-4\">\n            \n            {/* Context Widget 1 */}\n            <div className=\"bg-white dark:bg-slate-900/60 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-850 flex-grow flex flex-col justify-between space-y-4\">\n              <div className=\"space-y-1.5\">\n                <span className=\"text-[10px] font-mono tracking-wider font-extrabold uppercase text-indigo-500\">\n                  SYSTEM VALUE ASSURANCE\n                </span>\n                <h4 className=\"text-base font-bold text-slate-850 dark:text-white\">\n                  Preventing Revenue Mismatch Cost\n                </h4>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400 leading-normal\">\n                  In large subscriber BSS setups, even a 0.1% sync drift between CRM contracts and underlying billing queues causes severe revenue leaks. Rigorous simulation ensures absolute convergence.\n                </p>\n              </div>\n\n              <div className=\"pt-2\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"h-10 w-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 font-sans font-bold text-sm shrink-0\">\n                    $0l\n                  </div>\n                  <div>\n                    <span className=\"block text-xs font-mono font-black uppercase text-slate-400\">POST-RELEASE LEAKS</span>\n                    <span className=\"text-xs text-emerald-500 font-bold\">100% CURED IN 4 KEY ROLLOUTS</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Context Widget 2 */}\n            <div className=\"bg-white dark:bg-slate-900/60 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-850 flex-grow flex flex-col justify-between space-y-4\">\n              <div className=\"space-y-1.5\">\n                <span className=\"text-[10px] font-mono tracking-wider font-extrabold uppercase text-emerald-500\">\n                  CRITICAL METRIC HIGHLIGHT\n                </span>\n                <h4 className=\"text-base font-bold text-slate-850 dark:text-white\">\n                  Fast Regression Check Cycle\n                </h4>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400 leading-normal\">\n                  Leveraging highly modular test design paradigms cuts cycle runtimes significantly. Re-running regression suites is no longer a bottleneck during deployment runs, driving high agility.\n                </p>\n              </div>\n\n              <div className=\"pt-2\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"h-10 w-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 font-sans font-bold text-sm shrink-0\">\n                    6.5x\n                  </div>\n                  <div>\n                    <span className=\"block text-xs font-mono font-black uppercase text-slate-400\">FASTER REGRESSIONS</span>\n                    <span className=\"text-xs text-slate-400\">40% Cycle Decrease at Capgemini</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
