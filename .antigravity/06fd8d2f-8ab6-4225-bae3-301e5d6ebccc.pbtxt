    instruction: "Update Academic Background and Career chronology roles to match user\'s actual Capgemini, Prodapt, Cognizant, Tech Mahindra, Accenture, and Gapbridge background."
    replacement_infos {
      original_chunk {
        target_content: "              {/* Career Chronology Map */}\n              <div className=\"space-y-2\">\n                <h3 className=\"text-[11px] font-mono font-black text-slate-950 uppercase tracking-widest border-b border-slate-201 pb-1\">\n                  Professional Experience Chronology\n                </h3>\n\n                <div className={`space-y-3.5 pt-1 ${includeTimeline ? \"border-l border-slate-300 pl-4.5 ml-2\" : \"\"}`}>\n                  \n                  {/* Capgemini Role */}\n                  <div className=\"relative\">\n                    {includeTimeline && (\n                      <div className=\"absolute -left-7 top-[5px] w-2.5 h-2.5 rounded-full bg-blue-600 border border-white\" />\n                    )}\n                    <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center\">\n                      <div>\n                        <h4 className=\"text-xs font-bold text-slate-950\">Test Architect & Lead</h4>\n                        <p className=\"text-[11px] font-mono text-slate-500\">Capgemini \342\200\224 Bengaluru, India</p>\n                      </div>\n                      <span className=\"text-[10px] font-mono text-slate-450 uppercase tracking-wider font-semibold\">2022 \342\200\224 Present</span>\n                    </div>\n                    <ul className=\"list-disc pl-4 text-slate-700 text-[11px] mt-1.5 space-y-1\">\n                      <li>Spearhead the end-to-end framework test architectures serving complex multinational client portfolios.</li>\n                      <li>Standardized enterprise automated testing frameworks, reducing cycle regressions by up to 40% across 5 delivery lines.</li>\n                      <li>Bridge product definitions and TM-Forum specifications directly down into actionable test suites securely.</li>\n                    </ul>\n                  </div>\n\n                  {/* Previous OSS/BSS Role */}\n                  <div className=\"relative\">\n                    {includeTimeline && (\n                      <div className=\"absolute -left-7 top-[5px] w-2.5 h-2.5 rounded-full bg-slate-400 border border-white\" />\n                    )}\n                    <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center\">\n                      <div>\n                        <h4 className=\"text-xs font-bold text-slate-950\">Senior Quality Specialist & Lead</h4>\n                        <p className=\"text-[11px] font-mono text-slate-500\">Telecom System Integrators</p>\n                      </div>\n                      <span className=\"text-[10px] font-mono text-slate-450 uppercase tracking-wider font-semibold\">2014 \342\200\224 2021</span>\n                    </div>\n                    <ul className=\"list-disc pl-4 text-slate-700 text-[11px] mt-1.5 space-y-1\">\n                      <li>Designed comprehensive validation structures for high-performance EMS northbound interface topologies.</li>\n                      <li>Ensured strict SLA parameters, transaction audits, and invoice calculators for over 3 major multiregional adapters.</li>\n                      <li>Collaborated with global stakeholders on direct CRM and Amdocs system migrations.</li>\n                    </ul>\n                  </div>\n\n                </div>\n              </div>\n\n              {/* Education & credentials */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pb-1\">\n                {/* Education section */}\n                <div className=\"space-y-1.5\">\n                  <h3 className=\"text-[11px] font-mono font-black text-slate-950 uppercase tracking-widest border-b border-slate-201 pb-1\">\n                    Academic Background\n                  </h3>\n                  <div>\n                    <h4 className=\"text-xs font-bold text-slate-950\">Bachelor of Engineering (B.E.)</h4>\n                    <p className=\"text-[10.5px] text-slate-500\">Telecom & Systems Interoperability Study</p>\n                  </div>\n                </div>"
        replacement_content: "              {/* Career Chronology Map */}\n              <div className=\"space-y-2\">\n                <h3 className=\"text-[11px] font-mono font-black text-slate-950 uppercase tracking-widest border-b border-slate-201 pb-1\">\n                  Professional Experience Chronology\n                </h3>\n\n                <div className={`space-y-3.5 pt-1 ${includeTimeline ? \"border-l border-slate-300 pl-4.5 ml-2\" : \"\"}`}>\n                  \n                  {/* Capgemini Role */}\n                  <div className=\"relative\">\n                    {includeTimeline && (\n                      <div className=\"absolute -left-7 top-[5px] w-2.5 h-2.5 rounded-full bg-blue-600 border border-white\" />\n                    )}\n                    <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center\">\n                      <div>\n                        <h4 className=\"text-xs font-bold text-slate-950\">Senior Professional 1</h4>\n                        <p className=\"text-[11px] font-mono text-slate-500\">Capgemini \342\200\224 Bengaluru, India</p>\n                      </div>\n                      <span className=\"text-[10px] font-mono text-slate-450 uppercase tracking-wider font-semibold\">Jan 2022 \342\200\224 Present</span>\n                    </div>\n                    <ul className=\"list-disc pl-4 text-slate-700 text-[11.5px] mt-1.5 space-y-0.5\">\n                      <li>Expert testing with 3GPP2 CDMA & 3GPP 5G/4G/3G/2G carrier platforms. Support client teams for UAT activities and release management.</li>\n                      <li>Received Outstanding Contribution in Delivery Award (Q2 2022) and Customer Delight Award (Q3 2022).</li>\n                    </ul>\n                  </div>\n\n                  {/* Prodapt Role */}\n                  <div className=\"relative\">\n                    {includeTimeline && (\n                      <div className=\"absolute -left-7 top-[5px] w-2.5 h-2.5 rounded-full bg-slate-400 border border-white\" />\n                    )}\n                    <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center\">\n                      <div>\n                        <h4 className=\"text-xs font-bold text-slate-950\">Lead Engineer</h4>\n                        <p className=\"text-[11px] font-mono text-slate-500\">Prodapt Solutions</p>\n                      </div>\n                      <span className=\"text-[10px] font-mono text-slate-450 uppercase tracking-wider font-semibold\">Jan 2021 \342\200\224 Jan 2022</span>\n                    </div>\n                    <ul className=\"list-disc pl-4 text-slate-700 text-[11.5px] mt-1.5 space-y-0.5\">\n                      <li>Designed end-to-end integration mapping over Singleview Billing System core modules, including customer provisioning, rating, invoicing, payments, collections, and bill-run operations.</li>\n                    </ul>\n                  </div>\n\n                  {/* Cognizant Role */}\n                  <div className=\"relative\">\n                    {includeTimeline && (\n                      <div className=\"absolute -left-7 top-[5px] w-2.5 h-2.5 rounded-full bg-slate-400 border border-white\" />\n                    )}\n                    <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center\">\n                      <div>\n                        <h4 className=\"text-xs font-bold text-slate-950\">Project Associate</h4>\n                        <p className=\"text-[11px] font-mono text-slate-500\">Cognizant Technology Solutions India Ltd</p>\n                      </div>\n                      <span className=\"text-[10px] font-mono text-slate-450 uppercase tracking-wider font-semibold\">Feb 2019 \342\200\224 Jan 2021</span>\n                    </div>\n                    <ul className=\"list-disc pl-4 text-slate-700 text-[11.5px] mt-1.5 space-y-0.5\">\n                      <li>Orchestrated system integration testing (SIT) between multiple core components of Singleview postpaid charging, resolving complex data flow errors.</li>\n                    </ul>\n                  </div>\n\n                  {/* Tech Mahindra, Accenture & Gapbridge */}\n                  <div className=\"relative\">\n                    {includeTimeline && (\n                      <div className=\"absolute -left-7 top-[5px] w-2.5 h-2.5 rounded-full bg-slate-400 border border-white\" />\n                    )}\n                    <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center\">\n                      <div>\n                        <h4 className=\"text-xs font-bold text-slate-950\">E2E Test Specialist (Various Roles)</h4>\n                        <p className=\"text-[11px] font-mono text-slate-500\">Tech Mahindra | Accenture | Gapbridge Software</p>\n                      </div>\n                      <span className=\"text-[10px] font-mono text-slate-450 uppercase tracking-wider font-semibold font-bold\">Nov 2014 \342\200\224 Feb 2019</span>\n                    </div>\n                    <ul className=\"list-disc pl-4 text-slate-700 text-[11.5px] mt-1.5 space-y-0.5\">\n                      <li>Led British Telecom customer ordering, employee discount e-commerce automations, and live interlock UAT testing operations.</li>\n                    </ul>\n                  </div>\n\n                </div>\n              </div>\n\n              {/* Education & credentials */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pb-1\">\n                {/* Education section */}\n                <div className=\"space-y-1.5\">\n                  <h3 className=\"text-[11px] font-mono font-black text-slate-950 uppercase tracking-widest border-b border-slate-201 pb-1\">\n                    Academic Background\n                  </h3>\n                  <div className=\"space-y-1\">\n                    <div>\n                      <h4 className=\"text-xs font-bold text-slate-950\">M.Sc in Science (MS)</h4>\n                      <p className=\"text-[10.5px] text-slate-500 font-mono\">Liverpool John Moores University (2022)</p>\n                    </div>\n                    <div>\n                      <h4 className=\"text-xs font-bold text-slate-950\">BCA (Bachelor of Computer Applications)</h4>\n                      <p className=\"text-[10.5px] text-slate-500 font-mono\">Bharathidasan University, Trichy (2012)</p>\n                    </div>\n                  </div>\n                </div>"
      }
      num_matches: 1
    }
  }
}
