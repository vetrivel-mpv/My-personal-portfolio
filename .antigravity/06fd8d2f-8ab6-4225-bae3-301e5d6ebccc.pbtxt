        target_content: "// Seed data for projects\nconst INITIAL_PROJECTS: Project[] = [\n  {\n    id: \"proj-1\",\n    title: \"Enterprise QA & Test Automation Framework\",\n    description: \"Architected a modular and highly reusable test automation framework at Capgemini, standardizing quality practices across multiple delivery teams and reducing regression cycles by 40%.\",\n    category: \"Test Architecture\",\n    icon: \"\342\232\231\357\270\217\",\n    techs: [\"Selenium\", \"Java\", \"Spring Boot\", \"Jira\", \"Confluence\", \"Jenkins\"],\n    impact: \"Regression cycle reduced by 40%; adopted across 5 client delivery streams.\",\n    createdAt: \"2024-03-15T08:00:00Z\"\n  },\n  {\n    id: \"proj-2\",\n    title: \"Multi-Vendor MNS Interface Validation\",\n    description: \"Validated complex southbound and northbound interfaces of Telecom Network Management Systems (NMS) across major industry vendors, ensuring full FCAPS and SNMP compliance.\",\n    category: \"Telecom OSS/BSS\",\n    icon: \"\360\237\223\241\",\n    techs: [\"SNMP\", \"Wireshark\", \"Linux\", \"SQL\", \"HP ALM\"],\n    impact: \"Achieved 100% interoperability across 3 major vendor platforms.\",\n    createdAt: \"2023-11-20T10:30:00Z\"\n  },\n  {\n    id: \"proj-3\",\n    title: \"Telecom CRM & Billing Microservices Integration\",\n    description: \"Designed end-to-end integration test structures and validated REST custom endpoints for a modernized BSS billing engine migration, serving millions of European subscribers.\",\n    category: \"Telecom OSS/BSS\",\n    icon: \"\360\237\222\260\",\n    techs: [\"REST APIs\", \"Postman\", \"SpringBoot\", \"Docker\", \"AWS\"],\n    impact: \"Zero post-release revenue-impacting defects over 4 critical rollouts.\",\n    createdAt: \"2024-01-10T14:15:00Z\"\n  },\n  {\n    id: \"proj-4\",\n    title: \"Cloud-Native Service Assurance Portal\",\n    description: \"Developed a full-stack proof-of-concept dashboard utilizing React and Spring Boot for live SLA status tracing, showcasing architectural transition readiness.\",\n    category: \"Full Stack\",\n    icon: \"\360\237\222\273\",\n    techs: [\"React\", \"TypeScript\", \"Spring Boot\", \"PostgreSQL\", \"Docker\"],\n    impact: \"Provided executive SLA compliance transparency; verified on AWS local stack.\",\n    createdAt: \"2024-05-01T09:00:00Z\"\n  }\n];"
        replacement_content: "// Seed data for projects\nconst INITIAL_PROJECTS: Project[] = [\n  {\n    id: \"proj-1\",\n    title: \"Verizon Prime Biller Wholesale\",\n    description: \"Led core BSS billing integration, validation and mediation checking for Verizon\'s wholesale channels and reseller billing partners in an extensive global team environment.\",\n    category: \"Telecom OSS/BSS\",\n    icon: \"\360\237\223\241\",\n    techs: [\"Singleview Billing\", \"SQL\", \"Mediation API\", \"UAT\", \"JIRA\"],\n    impact: \"Successfully integrated complex contract validation for multi-million dollar wholesale billing accounts.\",\n    createdAt: \"2024-03-15T08:00:00Z\"\n  },\n  {\n    id: \"proj-2\",\n    title: \"Capgemini Regression Cycle Automation\",\n    description: \"Designed and engineered a robust modular Java Selenium Grid framework architecture, standardizing automation protocols and significantly optimizing delivery cycles.\",\n    category: \"Test Architecture\",\n    icon: \"\342\232\231\357\270\217\",\n    techs: [\"Java 21\", \"Selenium Grid\", \"Spring Boot\", \"Docker\", \"TestNG\"],\n    impact: \"Reduced regression execution durations by 40% across Capgemini delivery lines.\",\n    createdAt: \"2024-01-10T14:15:00Z\"\n  },\n  {\n    id: \"proj-3\",\n    title: \"Inmarsat Billing Transformation Programme\",\n    description: \"Worked on billing and mediation systems of CSG International to manage wholesale channel billing systems, optimizing rate plan setups and voucher management.\",\n    category: \"Telecom OSS/BSS\",\n    icon: \"\360\237\222\260\",\n    techs: [\"CSG Singleview\", \"Database Schema\", \"SIT Testing\", \"Revenue Assurance\"],\n    impact: \"Ensured seamless partner billing migration with zero post-release SLA leakage.\",\n    createdAt: \"2023-11-20T10:30:00Z\"\n  },\n  {\n    id: \"proj-4\",\n    title: \"BT Retail Core Mobile Ordering System\",\n    description: \"Conducted extensive end-to-end testing, planning and functional document preparations for BT Group\'s employee discount and mobile subscription customer ordering portal.\",\n    category: \"Telecom OSS/BSS\",\n    icon: \"\360\237\223\261\",\n    techs: [\"E-commerce\", \"UAT Scenarios\", \"UAT Data Setup\", \"HP ALM\"],\n    impact: \"Delivered brand new retail features to live production databases without any severe P1/P2 defects.\",\n    createdAt: \"2024-05-01T09:00:00Z\"\n  }\n];"
      }
