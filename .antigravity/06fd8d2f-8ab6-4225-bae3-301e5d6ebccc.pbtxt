        lines {
          text: "export function addMessage(message: Omit<ContactMessage, \"id\" | \"createdAt\">): ContactMessage {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const messages = getMessages();"
