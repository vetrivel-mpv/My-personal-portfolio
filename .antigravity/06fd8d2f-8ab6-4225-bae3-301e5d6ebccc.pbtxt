      original_chunk {
        target_content: "      {/* Modern, clean Minimalist Footer */}\n      <footer className=\"bg-slate-100 dark:bg-slate-950 border-t border-slate-200/40 dark:border-slate-850 py-10 px-4 md:px-8\">\n        <div className=\"max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"text-center md:text-left space-y-1\">\n            <h4 className=\"text-[11px] font-mono tracking-widest text-slate-500 uppercase\">vetrivel@muthusamy</h4>\n            <p className=\"text-[10px] text-slate-400 dark:text-slate-500\">\n              \302\251 2026. Architected for peak speed, accessibility, and clean responsive compliance.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-4 text-xs font-mono text-slate-400 dark:text-slate-500\">\n            <a href=\"mailto:vetrivelm02@gmail.com\" className=\"hover:text-blue-500 transition-colors\">email</a>\n            <span>\302\267</span>\n            <a href=\"https://linkedin.com/in/vetrivelm\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"hover:text-blue-500 transition-colors\">linkedin</a>\n            <span>\302\267</span>\n            <span className=\"text-[10px] uppercase text-slate-500 flex items-center gap-1 bg-slate-200/50 dark:bg-slate-900 px-2.5 py-1 rounded\">\n              <RefreshCw size={10} className=\"animate-spin duration-3000\" />\n              11+ YRS IN QUALITY\n            </span>\n          </div>\n        </div>\n      </footer>"
        replacement_content: "      {/* Modern, clean Minimalist Footer */}\n      <footer className=\"bg-slate-100 dark:bg-slate-950 border-t border-slate-200/40 dark:border-slate-850 py-10 px-4 md:px-8\">\n        <div className=\"max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"text-center md:text-left space-y-1\">\n            <h4 className=\"text-[11px] font-mono tracking-widest text-slate-500 uppercase\">vetrivel@muthusamy</h4>\n            <p className=\"text-[10px] text-slate-400 dark:text-slate-500\">\n              \302\251 2026. Architected for peak speed, accessibility, and clean responsive compliance.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-4 text-xs font-mono text-slate-400 dark:text-slate-500\">\n            <button \n              onClick={handleCopyEmail}\n              id=\"footer-copy-email-trigger\"\n              className=\"hover:text-blue-500 text-slate-400 dark:text-slate-505 transition-colors flex items-center gap-1.5 cursor-pointer bg-transparent border-none outline-none font-mono\"\n              title=\"Click to copy email address\"\n            >\n              <Mail size={12} className=\"shrink-0\" />\n              <span>Copy Email</span>\n            </button>\n            <span>\302\267</span>\n            <a href=\"https://linkedin.com/in/vetrivelm\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"hover:text-blue-500 transition-colors\">linkedin</a>\n            <span>\302\267</span>\n            <span className=\"text-[10px] uppercase text-slate-500 flex items-center gap-1 bg-slate-200/50 dark:bg-slate-900 px-2.5 py-1 rounded\">\n              <RefreshCw size={10} className=\"animate-spin duration-3000\" />\n              11+ YRS IN QUALITY\n            </span>\n          </div>\n        </div>\n      </footer>\n\n      {/* Floating dynamic clipboard alert toast */}\n      {toastMessage && (\n        <div \n          id=\"clipboard-toast\"\n          className=\"fixed bottom-20 right-6 z-55 flex items-center gap-2.5 px-4 py-3 bg-slate-900 border border-slate-800 dark:bg-white dark:border-slate-200 text-white dark:text-slate-900 text-xs font-mono rounded-xl shadow-2xl transition-all duration-300 animate-slide-in-right\"\n        >\n          <div className=\"h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse shrink-0\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}"
      }
      num_matches: 1
    }
  }
