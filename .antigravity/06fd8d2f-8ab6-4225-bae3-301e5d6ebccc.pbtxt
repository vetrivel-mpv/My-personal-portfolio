  file_change {
    absolute_path_uri: "file:///src/components/InteractiveBlueprint.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  Network, \n  Cpu, \n  Database, \n  Activity, \n  Settings, \n  CheckCircle, \n  ShieldCheck, \n  AlertTriangle, \n  HelpCircle, \n  Terminal,\n  Layers,\n  Search,\n  Radio,\n  Sliders,\n  DollarSign\n} from \"lucide-react\";\n\ninterface LayerDetail {\n  id: string;\n  name: string;\n  subtitle: string;\n  status: \"ACTIVE\" | \"VERIFIED\" | \"STABLE\" | \"OPTIMIZED\";\n  techStack: string[];\n  description: string;\n  failureCured: string;\n  businessImpact: string;\n  tnmStandard: string;\n}\n\nexport default function InteractiveBlueprint() {\n  const [selectedLayerId, setSelectedLayerId] = useState<string>(\"layer-2\");\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n\n  const layers: LayerDetail[] = [\n    {\n      id: \"layer-1\",\n      name: \"1. Southbound Mediation & Network Topology\",\n      subtitle: \"Physical & Logical Network Resource Mapping (OSS Tier)\",\n      status: \"VERIFIED\",\n      techStack: [\"SNMP\", \"Wireshark\", \"Linux Shell\", \"SQL DBs\", \"HP ALM\", \"Fiber Optics\"],\n      description: \"This layer maps physical endpoints, multi-vendor switches, routers, and SNMP protocol collectors. Solutions must integrate proprietary EMS topologies into unified carrier directories seamlessly.\",\n      failureCured: \"SNMP trap-storm lockups during simulated fiber-cut disasters. Solved with robust throttling validation.\",\n      businessImpact: \"Ensures 100% telemetry validation across 3 major vendor ecosystems (European & US regional networks).\",\n      tnmStandard: \"TM Forum eTOM Resource Management & FCAPS standards.\"\n    },\n    {\n      id: \"layer-2\",\n      name: \"2. Mediation & REST Middleware Integration\",\n      subtitle: \"Java Microservices, SLA Audits & Mediation Queues\",\n      status: \"OPTIMIZED\",\n      techStack: [\"Java\", \"Spring Boot\", \"REST APIs\", \"Postman\", \"Docker\", \"SLA Monitors\"],\n      description: \"The core system mediator orchestrating state routing, processing customer transaction requests, and triggering real-time validation across asynchronous microservices.\",\n      failureCured: \"Concurrency lockups and asynchronous order processing race conditions. Tested and mitigated via high-fidelity custom scripts.\",\n      businessImpact: \"Reduced regression automation cycles by 40% using advanced modular Java test frameworks at Capgemini.\",\n      tnmStandard: \"RESTful OpenAPI specification compliance with zero deviation.\"\n    },\n    {\n      id: \"layer-3\",\n      name: \"3. BSS Subscription, CRM & Billing Engine\",\n      subtitle: \"Revenue Management & Account Sync Systems\",\n      status: \"STABLE\",\n      techStack: [\"Oracle CRM\", \"Mediation Queues\", \"Aria Billing\", \"Amdocs Integration\", \"Billing Rules\"],\n      description: \"Handles subscription lifecycle, service state activations, pricing calculators, billing streams, and transactional database integrity for millions of tier-1 carrier users.\",\n      failureCured: \"Post-release subscription mismatches resulting in partial billing leaks. Saved millions of leakage dollars in live networks.\",\n      businessImpact: \"Achieved zero post-release revenue-impacting defects across 4 critical enterprise rollouts.\",\n      tnmStandard: \"TM Forum TAM & SID customer data schema representation.\"\n    },\n    {\n      id: \"layer-4\",\n      name: \"4. Unified SLA Control & Client Portal\",\n      subtitle: \"Full-Stack Portal & Analytics Service Assurance\",\n      status: \"ACTIVE\",\n      techStack: [\"React 18+\", \"TypeScript\", \"Tailwind CSS\", \"Spring Boot\", \"DevOps Pipelines\"],\n      description: \"Constructs the end-user control deck, rendering real-time metrics, system health logs, SLA compliance records, and administrative controls (Console).\",\n      failureCured: \"Lack of executive SLA traceability. Developed full-stack cloud proofs-of-concept for real-time customer transparency.\",\n      businessImpact: \"Replaced slow manual status reports with atomic, live-refreshing digital blueprint interfaces.\",\n      tnmStandard: \"W3C Accessibility (WCAG 2.1 AA) and modular component architecture.\"\n    }\n  ];\n\n  const currentLayer = layers.find(l => l.id === selectedLayerId) || layers[1];\n\n  return (\n    <section id=\"blueprint-playground\" className=\"py-20 px-4 md:px-8 xl:px-12 bg-white dark:bg-slate-950 text-slate-800 dark:text-slate-100 border-t border-b border-slate-150 dark:border-slate-900 transition-colors duration-300\">\n      <div className=\"max-w-6xl mx-auto space-y-12\">\n        \n        {/* Header Block with Blueprint Branding */}\n        <div className=\"space-y-4\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-8 h-[2px] bg-blue-500\" />\n            <span className=\"font-mono text-xs text-blue-500 uppercase tracking-widest font-semibold\">interactive sandbox</span>\n          </div>\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4\">\n            <div>\n              <h2 className=\"text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight\">\n                Carrier Architecture Interactive Blueprint\n              </h2>\n              <p className=\"text-sm text-slate-500 dark:text-slate-400 max-w-2xl mt-1 leading-relaxed\">\n                Experience an interactive engineering view of full-scale Telecom systems. Click on any block in the schematic layout below to inspect its operational layer, tech stacks, and live challenges Vetrivel solved.\n              </p>\n            </div>\n            \n            <div className=\"shrink-0 flex items-center gap-1.5 px-3 py-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-850 rounded-lg text-[11px] font-mono font-medium\">\n              <Terminal size={12} className=\"text-blue-500\" />\n              <span>DIAGRAM PROTOCOL: ACTIVE</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Modular Playground Sandbox Layout */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Grid: SVG Blueprint Schematic Card (lg:col-span-6) */}\n          <div className=\"lg:col-span-6 space-y-4\">\n            <div className=\"relative p-6 rounded-2xl border border-slate-250 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/10 overflow-hidden\">\n              {/* Engineering Grid Underlay */}\n              <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#e2e8f0_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f0_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:1.5rem_1.5rem] opacity-25 dark:opacity-40 pointer-events-none\" />\n              \n              <div className=\"relative z-10 space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-mono tracking-wider text-slate-400 dark:text-slate-500\">SCHEMATIC DIAGRAM: INTEGRATED TMR-MODEL</span>\n                  <Sliders size={14} className=\"text-slate-400\" />\n                </div>\n\n                {/* 4 Block Architectural Towers */}\n                <div className=\"space-y-3.5 pt-2\">\n                  {layers.map((layer, index) => {\n                    const isSelected = layer.id === selectedLayerId;\n                    const isHovered = hoveredNode === layer.id;\n                    \n                    return (\n                      <button\n                        key={layer.id}\n                        onClick={() => setSelectedLayerId(layer.id)}\n                        onMouseEnter={() => setHoveredNode(layer.id)}\n                        onMouseLeave={() => setHoveredNode(null)}\n                        className={`w-full text-left p-4 rounded-xl border transition-all duration-250 relative flex items-center justify-between cursor-pointer focus:outline-none ${\n                          isSelected\n                            ? \"bg-blue-50/90 dark:bg-blue-950/40 border-blue-500 shadow-md ring-1 ring-blue-500/20\"\n                            : isHovered\n                            ? \"bg-slate-100 dark:bg-slate-900 border-slate-300 dark:border-slate-700\"\n                            : \"bg-white dark:bg-slate-950 border-slate-200 dark:border-slate-850\"\n                        }`}\n                      >\n                        {/* Selected vertical light line indicator */}\n                        {isSelected && (\n                          <span className=\"absolute left-[-1px] top-4 bottom-4 w-1 rounded-r-lg bg-blue-500\" />\n                        )}\n\n                        <div className=\"flex items-start gap-3.5\">\n                          {/* Circle Counter with connected line simulation */}\n                          <div className={`w-8 h-8 rounded-lg shrink-0 flex items-center justify-center text-xs font-mono font-bold transition-all ${\n                            isSelected\n                              ? \"bg-blue-600 text-white\"\n                              : \"bg-slate-100 dark:bg-slate-900 text-slate-500 group-hover:text-slate-700\"\n                          }`}>\n                            0{index + 1}\n                          </div>\n                          \n                          <div className=\"space-y-0.5\">\n                            <h4 className={`text-xs font-bold leading-tight ${isSelected ? \"text-blue-600 dark:text-sky-300\" : \"text-slate-800 dark:text-white\"}`}>\n                              {layer.name.replace(/^\\d+\\.\\s*/, \"\")}\n                            </h4>\n                            <p className=\"text-[10.5px] text-slate-500 dark:text-slate-400 font-mono\">\n                              {layer.subtitle}\n                            </p>\n                          </div>\n                        </div>\n\n                        {/* Status tag */}\n                        <span className={`px-2 py-0.5 rounded text-[9px] font-mono tracking-wider font-semibold ${\n                          isSelected \n                            ? \"bg-blue-500/10 text-blue-600 dark:text-sky-450\"\n                            : \"bg-slate-100 dark:bg-slate-900 text-slate-450 dark:text-slate-500\"\n                        }`}>\n                          {layer.status}\n                        </span>\n                      </button>\n                    );\n                  })}\n                </div>\n\n                {/* Flow Lines Connections indicator */}\n                <div className=\"flex items-center justify-between text-[10px] font-mono text-slate-400 dark:text-slate-550 pt-2 border-t border-slate-200 dark:border-slate-850/60\">\n                  <span className=\"flex items-center gap-1\">\n                    <Radio size={11} className=\"text-emerald-500 text-xs animate-pulse\" /> Live Telemetry Flow\n                  </span>\n                  <span>100% Interoperable Framework</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Quick architectural values showcase */}\n            <div className=\"grid grid-cols-3 gap-3\">\n              <div className=\"p-3 bg-slate-50/50 dark:bg-slate-900/15 border border-slate-200 dark:border-slate-850 rounded-xl text-center\">\n                <span className=\"block text-xs font-mono text-slate-450\">TMF COMPLIANT</span>\n                <span className=\"text-[11px] font-bold text-slate-700 dark:text-slate-300\">Yes (eTOM / SID)</span>\n              </div>\n              <div className=\"p-3 bg-slate-50/50 dark:bg-slate-900/15 border border-slate-200 dark:border-slate-850 rounded-xl text-center\">\n                <span className=\"block text-xs font-mono text-slate-450\">AGILE MINDSET</span>\n                <span className=\"text-[11px] font-bold text-slate-700 dark:text-slate-300\">Scrum Certified</span>\n              </div>\n              <div className=\"p-3 bg-slate-50/50 dark:bg-slate-900/15 border border-slate-200 dark:border-slate-850 rounded-xl text-center\">\n                <span className=\"block text-xs font-mono text-slate-450\">DOMAIN DEPTH</span>\n                <span className=\"text-[11px] font-bold text-slate-700 dark:text-slate-300\">11+ Years OSS/BSS</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Grid: Detailed Analytical Blueprint Report Card (lg:col-span-6) */}\n          <div className=\"lg:col-span-6\">\n            <div className=\"rounded-2xl border border-slate-250 dark:border-slate-800 bg-white dark:bg-slate-950 p-6 shadow-xl relative overflow-hidden space-y-6\">\n              \n              {/* Accent header stripes */}\n              <div className=\"absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-blue-500 via-indigo-500 to-emerald-500 md:block hidden\" />\n\n              {/* Title & Badge */}\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"px-2.5 py-0.5 rounded text-[10px] font-mono uppercase bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold tracking-wider flex items-center gap-1\">\n                    <ShieldCheck size={11} /> LAYER {currentLayer.id.replace(\"layer-\", \"\")} REPORT\n                  </span>\n                  <span className=\"text-xs font-mono text-slate-400\">STATUS.sys: STABLE</span>\n                </div>\n                \n                <h3 className=\"text-xl font-black text-slate-900 dark:text-white leading-tight\">\n                  {currentLayer.name}\n                </h3>\n              </div>\n\n              {/* Tech stack badges */}\n              <div className=\"space-y-2\">\n                <span className=\"block text-[10px] font-mono tracking-widest text-slate-400 dark:text-slate-500 uppercase\">TECHNOLOGY STACK VERIFIED:</span>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {currentLayer.techStack.map((tech) => (\n                    <span \n                      key={tech} \n                      className=\"px-2.5 py-1 text-[10.5px] font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-850 text-slate-650 dark:text-slate-350 rounded\"\n                    >\n                      {tech}\n                    </span>\n                  ))}\n                </div>\n              </div>\n\n              {/* Layer detailed explanation */}\n              <div className=\"space-y-1.5\">\n                <span className=\"block text-[10px] font-mono tracking-widest text-slate-400 dark:text-slate-500 uppercase\">LAYER OVERVIEW & CODES:</span>\n                <p className=\"text-[12.5px] text-slate-600 dark:text-slate-300 leading-relaxed font-sans\">\n                  {currentLayer.description}\n                </p>\n              </div>\n\n              {/* Cured System Failures highlighted block (Most persuasive element for recruitments!) */}\n              <div className=\"p-4 rounded-xl border border-rose-500/20 dark:border-rose-500/10 bg-rose-50/35 dark:bg-rose-500/[0.02] space-y-1.5\">\n                <div className=\"flex items-center gap-1.5 text-xs text-rose-600 dark:text-rose-400 font-bold font-sans\">\n                  <AlertTriangle size={13} className=\"shrink-0\" /> System Outage Avoided & Challenge Overcome\n                </div>\n                <p className=\"text-[11px] text-slate-600 dark:text-slate-400 font-sans leading-relaxed\">\n                  <strong className=\"text-slate-800 dark:text-slate-200\">Failure Cured:</strong> {currentLayer.failureCured}\n                </p>\n              </div>\n\n              {/* Business Value Cured */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\">\n                <div className=\"space-y-1\">\n                  <span className=\"block text-[10px] font-mono tracking-widest text-slate-400 dark:text-slate-500 uppercase\">DELIVERED VALUE / IMPACT</span>\n                  <p className=\"text-xs text-slate-800 dark:text-slate-200 font-semibold leading-relaxed\">\n                    {currentLayer.businessImpact}\n                  </p>\n                </div>\n                <div className=\"space-y-1 border-t sm:border-t-0 sm:border-l border-slate-200 dark:border-slate-800 pt-3 sm:pt-0 sm:pl-4\">\n                  <span className=\"block text-[10px] font-mono tracking-widest text-slate-400 dark:text-slate-500 uppercase\">FRAMEWORK STANDARD</span>\n                  <p className=\"text-xs text-slate-800 dark:text-slate-200 font-semibold leading-relaxed\">\n                    {currentLayer.tnmStandard}\n                  </p>\n                </div>\n              </div>\n\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
