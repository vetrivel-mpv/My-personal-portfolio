  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \"react\";\nimport { Award, Briefcase, ChevronUp, Github, Linkedin, Mail, Phone, ExternalLink, RefreshCw } from \"lucide-react\";\nimport Navbar from \"./components/Navbar\";\nimport Hero from \"./components/Hero\";\nimport ProjectGallery from \"./components/ProjectGallery\";\nimport BlogSection from \"./components/BlogSection\";\nimport ContactForm from \"./components/ContactForm\";\nimport AdminDashboard from \"./components/AdminDashboard\";\nimport { getProjects, getBlogs } from \"./db/storage\";\nimport { Project, BlogPost } from \"./types\";\n\nexport default function App() {\n  const [isAdminMode, setIsAdminMode] = useState(false);\n  \n  // Real-time local state triggers\n  const [projects, setProjects] = useState<Project[]>([]);\n  const [blogs, setBlogs] = useState<BlogPost[]>([]);\n  const [refreshTrigger, setRefreshTrigger] = useState(0);\n  const [showScrollTop, setShowScrollTop] = useState(false);\n\n  // Sync data whenever content changes\n  useEffect(() => {\n    setProjects(getProjects());\n    setBlogs(getBlogs());\n  }, [refreshTrigger]);\n\n  // Handles scroll performance for \"Go to Top\" indicator\n  useEffect(() => {\n    const toggleVisibility = () => {\n      setShowScrollTop(window.scrollY > 300);\n    };\n    window.addEventListener(\"scroll\", toggleVisibility);\n    return () => window.removeEventListener(\"scroll\", toggleVisibility);\n  }, []);\n\n  const handleRefreshData = () => {\n    setRefreshTrigger((prev) => prev + 1);\n  };\n\n  const scrollToTop = () => {\n    window.scrollTo({\n      top: 0,\n      behavior: \"smooth\"\n    });\n  };\n\n  const scrollToSection = (id: string) => {\n    const el = document.getElementById(id);\n    if (el) {\n      el.scrollIntoView({ behavior: \"smooth\" });\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col justify-between bg-white dark:bg-slate-950 text-slate-800 dark:text-slate-100 transition-colors duration-300\">\n      \n      {/* Premium Navbar with modes toggles */}\n      <Navbar\n        isAdminMode={isAdminMode}\n        onAdminToggle={() => setIsAdminMode(true)}\n        onViewAsVisitor={() => setIsAdminMode(false)}\n      />\n\n      {/* Main Container */}\n      <main className=\"flex-grow pt-16\">\n        {isAdminMode ? (\n          // Secure Administrative Dashboard Console Custom uploads\n          <div className=\"animate-fade-up\">\n            <AdminDashboard onDataChanged={handleRefreshData} />\n          </div>\n        ) : (\n          // High-Fidelity Personal Portfolio Visitor Journey\n          <div className=\"space-y-0\">\n            {/* 1. Stunning Hero introduction presenting career arc and milestone metrics */}\n            <Hero\n              onExploreProjects={() => scrollToSection(\"projects\")}\n              onExploreVision={() => scrollToSection(\"vision-section\")}\n            />\n\n            {/* 2. Professional career progression blueprint diagram */}\n            <section id=\"vision-section\" className=\"py-20 px-4 md:px-8 xl:px-12 bg-slate-55 dark:bg-slate-950 text-slate-800 dark:text-slate-100 border-t border-slate-150 dark:border-slate-900 transition-colors duration-300\">\n              <div className=\"max-w-4xl mx-auto space-y-12\">\n                <div className=\"space-y-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"w-8 h-[2px] bg-blue-500\" />\n                    <span className=\"font-mono text-xs text-blue-500 uppercase tracking-widest font-semibold\">00 / ALIGNMENT & MISSION</span>\n                  </div>\n                  <h2 className=\"text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight\">\n                    Why Solution Architect?\n                  </h2>\n                  <p className=\"text-sm text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed\">\n                    A great architect does not just construct models; they translate complex customer systems into business value while ensuring pristine structural standards. Here is the architecture of my career progression:\n                  </p>\n                </div>\n\n                {/* Vertical interactive pipeline design */}\n                <div className=\"space-y-6 pt-4 relative col-span-1 border-l border-slate-250 dark:border-slate-800 pl-6 ml-3\">\n                  \n                  {/* Phase 1 */}\n                  <div className=\"relative group\">\n                    <div className=\"absolute -left-9 top-1 w-6 h-6 rounded-full border-2 border-slate-350 dark:border-slate-700 bg-white dark:bg-slate-950 flex items-center justify-center text-xs text-slate-400 group-hover:border-blue-500 transition-colors\">\n                      1\n                    </div>\n                    <div>\n                      <h4 className=\"text-xs font-mono font-bold uppercase text-slate-400\">Phase 1: Domain Mastery & QA (2014 \342\200\223 2021)</h4>\n                      <p className=\"text-sm font-bold text-slate-800 dark:text-white mt-1\">Telecom OSS/BSS Explorer</p>\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400 leading-relaxed mt-1\">\n                        Formed high-precision system analytics depth across major network management vendors. Validated interfaces, billing engines, and SLA processes serving European and US customers. Learn exactly how large systems fail.\n                      </p>\n                    </div>\n                  </div>\n\n                  {/* Phase 2 */}\n                  <div className=\"relative group\">\n                    <div className=\"absolute -left-9 top-1 w-6 h-6 rounded-full border-2 border-slate-350 dark:border-slate-700 bg-white dark:bg-slate-950 flex items-center justify-center text-xs text-slate-400 group-hover:border-blue-500 transition-colors\">\n                      2\n                    </div>\n                    <div>\n                      <h4 className=\"text-xs font-mono font-bold uppercase text-slate-400\">Phase 2: Full-Stack Expansion (Partner track)</h4>\n                      <p className=\"text-sm font-bold text-slate-800 dark:text-white mt-1\">Acquiring Core Developer Fluency</p>\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400 leading-relaxed mt-1\">\n                        Deliberate investment in Java, Spring Boot, REST endpoints, Docker and React. Not merely to write lines of code, but to understand and speak the engineering languages of delivery squads.\n                      </p>\n                    </div>\n                  </div>\n\n                  {/* Phase 3 */}\n                  <div className=\"relative group\">\n                    <div className=\"absolute -left-9 top-1 w-6 h-6 rounded-full border-2 border-slate-350 dark:border-slate-700 bg-white dark:bg-slate-950 flex items-center justify-center text-xs text-slate-400 group-hover:border-blue-500 transition-colors\">\n                      3\n                    </div>\n                    <div>\n                      <h4 className=\"text-xs font-mono font-bold uppercase text-slate-400\">Phase 3: Team & Quality Architecture (2022 \342\200\223 Present)</h4>\n                      <p className=\"text-sm font-bold text-slate-800 dark:text-white mt-1\">Test Architect & Lead @ Capgemini</p>\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400 leading-relaxed mt-1\">\n                        Spearheading QA frameworks across massive client portfolios. Bridging business requirement documents directly into high-fidelity code bases securely. Driving agile standardizations.\n                      </p>\n                    </div>\n                  </div>\n\n                  {/* Phase 4 */}\n                  <div className=\"relative group\">\n                    <div className=\"absolute -left-9 top-1 w-6 h-6 rounded-full bg-blue-600 border-2 border-blue-600 flex items-center justify-center text-xs text-white font-bold\">\n                      \342\230\205\n                    </div>\n                    <div>\n                      <h4 className=\"text-xs font-mono font-bold uppercase text-sky-400\">Target Role</h4>\n                      <p className=\"text-sm font-bold text-blue-600 dark:text-sky-300 mt-1\">Solution Architect (OSS/BSS Core Systems)</p>\n                      <p className=\"text-xs text-slate-550 dark:text-slate-450 leading-relaxed mt-1\">\n                        Fusing a rare combination of exhaustive end-to-end domain logic, deep full-stack proficiency, enterprise scale process architectures, and active Certified Scrum Product Owner (CSPO) credentials.\n                      </p>\n                    </div>\n                  </div>\n\n                </div>\n              </div>\n            </section>\n\n            {/* 3. Infinite project grid with interactive category search and filters */}\n            <ProjectGallery projects={projects} />\n\n            {/* 4. Elegant Reflections Blog with modal detailed readers */}\n            <BlogSection blogs={blogs} />\n\n            {/* 5. Fully responsive secure contact form with social handles */}\n            <ContactForm onMessageSubmitted={handleRefreshData} />\n          </div>\n        )}\n      </main>\n\n      {/* Modern, clean Minimalist Footer */}\n      <footer className=\"bg-slate-100 dark:bg-slate-950 border-t border-slate-200/40 dark:border-slate-850 py-10 px-4 md:px-8\">\n        <div className=\"max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"text-center md:text-left space-y-1\">\n            <h4 className=\"text-[11px] font-mono tracking-widest text-slate-500 uppercase\">vetrivel@muthusamy</h4>\n            <p className=\"text-[10px] text-slate-400 dark:text-slate-500\">\n              \302\251 2026. Architected for peak speed, accessibility, and clean responsive compliance.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-4 text-xs font-mono text-slate-400 dark:text-slate-500\">\n            <a href=\"mailto:vetrivelm02@gmail.com\" className=\"hover:text-blue-500 transition-colors\">email</a>\n            <span>\302\267</span>\n            <a href=\"https://linkedin.com/in/vetrivelm\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"hover:text-blue-500 transition-colors\">linkedin</a>\n            <span>\302\267</span>\n            <span className=\"text-[10px] uppercase text-slate-500 flex items-center gap-1 bg-slate-200/50 dark:bg-slate-900 px-2.5 py-1 rounded\">\n              <RefreshCw size={10} className=\"animate-spin duration-3000\" />\n              11+ YRS IN QUALITY\n            </span>\n          </div>\n        </div>\n      </footer>\n\n      {/* Compact scroll back to top bubble */}\n      {showScrollTop && (\n        <button\n          onClick={scrollToTop}\n          title=\"Scroll to Top\"\n          className=\"fixed bottom-6 right-6 w-9 h-9 text-xs rounded-full bg-blue-600 text-white flex items-center justify-center hover:bg-blue-500 shadow-xl snap-center duration-200 cursor-pointer animate-fade-up\"\n        >\n          <ChevronUp size={16} />\n        </button>\n      )}\n\n    </div>\n  );\n}\n"
    }
    diff {
