  file_change {
    absolute_path_uri: "file:///src/components/ProjectGallery.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useMemo } from \"react\";\nimport { Search, FolderGit2, Sparkles, Filter, ExternalLink } from \"lucide-react\";\nimport { Project } from \"../types\";\n\ninterface ProjectGalleryProps {\n  projects: Project[];\n}\n\nexport default function ProjectGallery({ projects }: ProjectGalleryProps) {\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [selectedCategory, setSelectedCategory] = useState<string>(\"All\");\n\n  const categories = useMemo(() => {\n    const list = [\"All\"];\n    projects.forEach((p) => {\n      if (!list.includes(p.category)) {\n        list.push(p.category);\n      }\n    });\n    return list;\n  }, [projects]);\n\n  const filteredProjects = useMemo(() => {\n    return projects.filter((project) => {\n      const matchesCategory =\n        selectedCategory === \"All\" || project.category === selectedCategory;\n      const lowerQuery = searchQuery.toLowerCase();\n      const matchesSearch =\n        project.title.toLowerCase().includes(lowerQuery) ||\n        project.description.toLowerCase().includes(lowerQuery) ||\n        project.techs.some((t) => t.toLowerCase().includes(lowerQuery)) ||\n        project.impact.toLowerCase().includes(lowerQuery);\n\n      return matchesCategory && matchesSearch;\n    });\n  }, [projects, searchQuery, selectedCategory]);\n\n  return (\n    <section id=\"projects\" className=\"py-20 px-4 md:px-8 xl:px-12 bg-slate-50 dark:bg-slate-900/[0.2] text-slate-800 dark:text-slate-100 transition-colors duration-300\">\n      <div className=\"max-w-6xl mx-auto space-y-12\">\n        {/* Header section */}\n        <div className=\"space-y-4\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-8 h-[2px] bg-blue-500\" />\n            <span className=\"font-mono text-xs text-blue-500 uppercase tracking-widest font-semibold\">01 / SHOWCASE & INITIATIVES</span>\n          </div>\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4\">\n            <div>\n              <h2 className=\"text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight\">\n                System Artifacts & Projects\n              </h2>\n              <p className=\"text-sm text-slate-500 dark:text-slate-400 max-w-lg mt-1\">\n                A selection of enterprise architectures, automated frameworks, and OSS/BSS validation programs designed and led over my career.\n              </p>\n            </div>\n\n            {/* Live Counter */}\n            <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-blue-50 dark:bg-blue-900/10 border border-blue-500/15 text-blue-600 dark:text-sky-400 text-xs font-mono font-medium\">\n              <FolderGit2 size={13} />\n              <span>{filteredProjects.length} Initiatives Listed</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Filter Toolbar (Search bar & Category buttons) */}\n        <div className=\"flex flex-col md:flex-row gap-4 justify-between items-stretch\">\n          {/* Search bar inputs */}\n          <div className=\"relative flex-1 max-w-md\">\n            <Search className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500\" size={16} />\n            <input\n              type=\"text\"\n              id=\"project-search-input\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"Search by title, technology, or business impact...\"\n              className=\"w-full pl-10 pr-4 py-2 text-xs font-sans rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-850 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 hover:border-slate-350 dark:hover:border-slate-700 focus:outline-none focus:ring-1 focus:ring-blue-500/50 focus:border-blue-500 transition-all duration-200\"\n            />\n          </div>\n\n          {/* Category badges list */}\n          <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 scrollbar-hide\">\n            <span className=\"text-xs text-slate-400 mr-1 flex items-center gap-1 shrink-0 font-mono\">\n              <Filter size={11} /> Filters:\n            </span>\n            {categories.map((cat) => (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3 py-1.5 rounded-lg text-[11px] font-mono whitespace-nowrap transition-all duration-205 cursor-pointer ${\n                  selectedCategory === cat\n                    ? \"bg-blue-600 dark:bg-blue-600 text-white font-semibold shadow-md shadow-blue-500/10\"\n                    : \"bg-white dark:bg-slate-950 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:bg-slate-150 dark:hover:bg-slate-900\"\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Dynamic Project grid display */}\n        {filteredProjects.length > 0 ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {filteredProjects.map((project) => (\n              <div\n                key={project.id}\n                id={`project-card-${project.id}`}\n                className=\"group relative flex flex-col justify-between p-6 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200/90 dark:border-slate-850 hover:border-blue-500/40 dark:hover:border-blue-500/40 hover:shadow-xl dark:hover:shadow-blue-500/[0.02] transition-all duration-300\"\n              >\n                {/* Visual design anchor line */}\n                <div className=\"absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-blue-500 to-indigo-500 rounded-t-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300\" />\n\n                <div className=\"space-y-4\">\n                  {/* Category + Icon representation */}\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"px-2.5 py-1 rounded text-[10px] font-mono uppercase tracking-wider font-semibold bg-blue-500/10 text-blue-600 dark:bg-blue-500/10 dark:text-sky-400\">\n                      {project.category}\n                    </span>\n                    <span className=\"text-xl px-2.5 py-1 bg-slate-100 dark:bg-slate-900 rounded-lg\">\n                      {project.icon || \"\342\232\231\357\270\217\"}\n                    </span>\n                  </div>\n\n                  {/* Title + Descr */}\n                  <div className=\"space-y-1.5\">\n                    <h3 className=\"text-lg font-bold text-slate-850 dark:text-white group-hover:text-blue-600 dark:group-hover:text-sky-400 transition-colors duration-200\">\n                      {project.title}\n                    </h3>\n                    <p className=\"text-xs text-slate-500 dark:text-slate-400 leading-relaxed\">\n                      {project.description}\n                    </p>\n                  </div>\n\n                  {/* Technology labels list */}\n                  <div className=\"flex flex-wrap gap-1.5 pt-2\">\n                    {project.techs.map((tech) => (\n                      <span\n                        key={tech}\n                        className=\"px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 border border-slate-200/30 dark:border-slate-800 text-[9px] font-mono text-slate-600 dark:text-slate-400\"\n                      >\n                        {tech}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Real-world Impact Section highlight */}\n                <div className=\"mt-5 pt-4 border-t border-slate-105 dark:border-slate-900 flex items-center justify-between gap-1\">\n                  <div className=\"space-y-0.5 max-w-[90%]\">\n                    <span className=\"text-[9px] font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500 flex items-center gap-1\">\n                      <Sparkles size={10} className=\"text-amber-500\" /> Delivered Impact\n                    </span>\n                    <span className=\"block text-xs font-sans font-medium text-emerald-600 dark:text-emerald-400\">\n                      {project.impact}\n                    </span>\n                  </div>\n                  <div className=\"shrink-0 text-slate-300 dark:text-slate-700 group-hover:text-blue-500 dark:group-hover:text-sky-400 transition-colors duration-200\">\n                    <ExternalLink size={14} />\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        ) : (\n          <div className=\"text-center py-16 bg-white dark:bg-slate-950 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800\">\n            <FolderGit2 className=\"mx-auto text-slate-400 mb-2\" size={32} />\n            <h3 className=\"text-sm font-bold text-slate-700 dark:text-slate-400\">No projects found</h3>\n            <p className=\"text-xs text-slate-400 mt-1 max-w-xs mx-auto\">\n              Try adjusting your query or filters. You can also log in to the CONSOLE to add new entries!\n            </p>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n"
    }
